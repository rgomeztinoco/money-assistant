#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
compose_file="${COMPOSE_FILE:-${script_directory}/compose.production.yaml}"
environment_file="${ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
openclaw_private_key_file="${OPENCLAW_PRIVATE_KEY_FILE:-/etc/money-assistant/secrets/openclaw_capability_private_key}"
openclaw_environment_file="${OPENCLAW_ENVIRONMENT_FILE:-/etc/money-assistant/openclaw.env}"
openclaw_service="${OPENCLAW_SERVICE:-openclaw-gateway.service}"
temporary_directory=''
rotation_complete=false
rotation_started=false
restore_openclaw_private_key_file=''
restore_application_public_key_file=''
restore_application_hook_token_file=''
restore_application_key_file=''
restore_application_previous_keys_file=''
restore_openclaw=false
restore_application_services=''

usage()
{
    printf '%s\n' 'Usage: rehearse-credential-rotation inbound PRIVATE_KEY_FILE PUBLIC_KEY_FILE KEY_ID'
    printf '%s\n' '       rehearse-credential-rotation outbound HOOK_TOKEN_FILE'
    printf '%s\n' '       rehearse-credential-rotation application APP_KEY_FILE PREVIOUS_KEYS_FILE'
}

fail()
{
    printf 'Credential rotation rehearsal failed: %s\n' "$1" >&2
    exit 1
}

cleanup()
{
    if [ -n "$temporary_directory" ] && [ -d "$temporary_directory" ]; then
        if [ "$rotation_started" = true ] && [ "$rotation_complete" = false ]; then
            restore_active_credentials
        fi

        rm -f -- "${temporary_directory}/financial-state-before" \
            "${temporary_directory}/financial-state-after" \
            "${temporary_directory}/production.env" \
            "${temporary_directory}/openclaw.env" \
            "${temporary_directory}/inbound-probe-body" \
            "${temporary_directory}/inbound-probe-curl" \
            "${temporary_directory}/outbound-probe-curl" \
            "${temporary_directory}/active-environment" \
            "${temporary_directory}/active-openclaw-environment" \
            "${temporary_directory}/active-openclaw-private-key" \
            "${temporary_directory}/active-application-public-key" \
            "${temporary_directory}/active-application-hook-token" \
            "${temporary_directory}/active-application-key" \
            "${temporary_directory}/active-application-previous-keys"
        rmdir -- "$temporary_directory"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

environment_value()
{
    requested_key="$1"

    while IFS='=' read -r key value; do
        if [ "$key" = "$requested_key" ]; then
            printf '%s\n' "$value"
            return 0
        fi
    done < "$environment_file"

    return 1
}

compose()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$environment_file" \
        --file "$compose_file" \
        "$@"
}

financial_state_fingerprint()
{
    compose exec --no-TTY web \
        /usr/local/bin/with-production-secrets \
        php artisan app:financial-state:fingerprint --no-interaction
}

restart_openclaw()
{
    systemctl --user restart "$openclaw_service"
    systemctl --user is-active --quiet "$openclaw_service"
}

install_secret()
{
    source_file="$1"
    target_file="$2"

    [ -f "$source_file" ] || fail 'a candidate secret file is missing'
    [ -s "$source_file" ] || fail 'a candidate secret file is empty'
    [ "$source_file" != "$target_file" ] || fail 'candidate and active secret paths must differ'

    if cmp --silent "$source_file" "$target_file"; then
        fail 'candidate and active secret values must differ'
    fi

    install -m 0600 "$source_file" "$target_file"
}

remember_active_secret()
{
    target_file="$1"
    backup_file="$2"

    [ -f "$target_file" ] || fail 'an active secret file is missing'
    install -m 0600 "$target_file" "$backup_file"
}

restore_active_credentials()
{
    if [ -n "$restore_openclaw_private_key_file" ]; then
        install -m 0600 \
            "${temporary_directory}/active-openclaw-private-key" \
            "$restore_openclaw_private_key_file"
    fi

    if [ -n "$restore_application_public_key_file" ]; then
        install -m 0600 \
            "${temporary_directory}/active-application-public-key" \
            "$restore_application_public_key_file"
    fi

    if [ -n "$restore_application_hook_token_file" ]; then
        install -m 0600 \
            "${temporary_directory}/active-application-hook-token" \
            "$restore_application_hook_token_file"
    fi

    if [ -n "$restore_application_key_file" ]; then
        install -m 0600 \
            "${temporary_directory}/active-application-key" \
            "$restore_application_key_file"
    fi

    if [ -n "$restore_application_previous_keys_file" ]; then
        install -m 0600 \
            "${temporary_directory}/active-application-previous-keys" \
            "$restore_application_previous_keys_file"
    fi

    if [ -f "${temporary_directory}/active-environment" ]; then
        install -m 0600 "${temporary_directory}/active-environment" "$environment_file"
    fi

    if [ -f "${temporary_directory}/active-openclaw-environment" ]; then
        install -m 0600 "${temporary_directory}/active-openclaw-environment" "$openclaw_environment_file"
    fi

    if [ "$restore_openclaw" = true ]; then
        restart_openclaw || true
    fi

    if [ -n "$restore_application_services" ]; then
        compose up --detach --wait --no-deps --force-recreate $restore_application_services || true
    fi
}

replace_environment_value_in_file()
{
    active_environment_file="$1"
    staging_file="${temporary_directory}/$2"
    requested_key="$3"
    requested_value="$4"
    found=false

    : > "$staging_file"

    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "${requested_key}"=*)
                printf '%s=%s\n' "$requested_key" "$requested_value" >> "$staging_file"
                found=true
                ;;
            *) printf '%s\n' "$line" >> "$staging_file" ;;
        esac
    done < "$active_environment_file"

    if [ "$found" = false ]; then
        printf '%s=%s\n' "$requested_key" "$requested_value" >> "$staging_file"
    fi

    install -m 0600 "$staging_file" "$active_environment_file"
}

probe_inbound_rotation()
{
    candidate_private_key_file="$1"
    candidate_key_id="$2"
    probe_body_file="${temporary_directory}/inbound-probe-body"
    probe_curl_file="${temporary_directory}/inbound-probe-curl"

    node - \
        "$candidate_private_key_file" \
        "$candidate_key_id" \
        "$probe_body_file" \
        "$probe_curl_file" <<'NODE' >/dev/null 2>&1 ||
const {
    createHash,
    createPrivateKey,
    randomUUID,
    sign,
} = require('node:crypto');
const { readFileSync, writeFileSync } = require('node:fs');

const [privateKeyFile, keyId, bodyFile, curlFile] = process.argv.slice(2);
const sodiumSecret = Buffer.from(readFileSync(privateKeyFile, 'utf8').trim(), 'base64');

if (sodiumSecret.length !== 32 && sodiumSecret.length !== 64) {
    process.exit(1);
}

const seed = sodiumSecret.subarray(0, 32);
const privateKey = createPrivateKey({
    key: Buffer.concat([
        Buffer.from('302e020100300506032b657004220420', 'hex'),
        seed,
    ]),
    format: 'der',
    type: 'pkcs8',
});
const timestamp = Math.floor(Date.now() / 1000).toString();
const nonce = randomUUID();
const body = JSON.stringify({
    schema_version: 1,
    capability: 'transaction.read',
    interaction: {
        kind: 'owner_message',
        agent_id: 'credential-rotation-probe',
        account_id: 'credential-rotation-probe',
        conversation_id: 'credential-rotation-probe',
        owner_sender_id: 'credential-rotation-probe',
        message_id: randomUUID(),
        occurred_at: new Date().toISOString(),
    },
    input: { transaction_id: 1 },
});
const signature = sign(
    null,
    Buffer.from([
        timestamp,
        nonce,
        'POST',
        '/api/openclaw/v1/transport',
        createHash('sha256').update(body).digest('hex'),
    ].join('\n')),
    privateKey,
).toString('base64');

writeFileSync(bodyFile, body, { mode: 0o600 });
writeFileSync(curlFile, [
    'url = "http://127.0.0.1:8443/api/openclaw/v1/transport"',
    'request = "POST"',
    'header = "Content-Type: application/json"',
    'header = "Accept: application/json"',
    `header = "X-Money-Assistant-Key-Id: ${keyId}"`,
    `header = "X-Money-Assistant-Timestamp: ${timestamp}"`,
    `header = "X-Money-Assistant-Nonce: ${nonce}"`,
    `header = "X-Money-Assistant-Signature: ${signature}"`,
    `data-binary = "@${bodyFile}"`,
].join('\n'), { mode: 0o600 });
NODE
        fail 'the candidate signing identity is invalid'

    probe_status="$(curl --silent --show-error \
        --output /dev/null \
        --write-out '%{http_code}' \
        --config "$probe_curl_file")" ||
        fail 'the rotated inbound credential could not reach Money Assistant'

    [ "$probe_status" = 422 ] ||
        fail 'the rotated inbound credential was not authenticated by Money Assistant'
}

probe_outbound_rotation()
{
    configured_hook_url="$1"
    candidate_hook_token="$2"
    probe_curl_file="${temporary_directory}/outbound-probe-curl"

    case "$configured_hook_url" in
        http://127.0.0.1:*/hooks/money-assistant)
            hook_port="${configured_hook_url#http://127.0.0.1:}"
            hook_port="${hook_port%/hooks/money-assistant}"
            ;;
        *) fail 'OPENCLAW_HOOK_URL must use the loopback OpenClaw hook endpoint' ;;
    esac

    case "$hook_port" in
        *[!0-9]*|'')
            fail 'OPENCLAW_HOOK_URL must use the loopback OpenClaw hook endpoint'
            ;;
    esac

    wake_url="http://127.0.0.1:${hook_port}/hooks/wake"

    printf '%s\n' \
        "url = \"${wake_url}\"" \
        'request = "POST"' \
        'header = "Content-Type: application/json"' \
        "header = \"Authorization: Bearer ${candidate_hook_token}\"" \
        'data = "{\"text\":\"Money Assistant credential rotation probe\",\"mode\":\"next-heartbeat\"}"' \
        > "$probe_curl_file"

    curl --silent --show-error --fail --output /dev/null \
        --config "$probe_curl_file" ||
        fail 'the rotated outbound credential was rejected by OpenClaw'
}

[ -r "$environment_file" ] || fail 'the production environment file is not readable'
[ -r "$openclaw_environment_file" ] || fail 'the OpenClaw environment file is not readable'

temporary_directory="$(mktemp -d)"
install -m 0600 "$environment_file" "${temporary_directory}/active-environment"
install -m 0600 "$openclaw_environment_file" "${temporary_directory}/active-openclaw-environment"
financial_state_before="${temporary_directory}/financial-state-before"
financial_state_after="${temporary_directory}/financial-state-after"
financial_state_fingerprint > "$financial_state_before"

direction="${1:-}"

case "$direction" in
    inbound)
        [ "$#" -eq 4 ] || { usage >&2; exit 64; }
        public_key_file="$(environment_value OPENCLAW_CAPABILITY_PUBLIC_KEY_FILE)" ||
            fail 'OPENCLAW_CAPABILITY_PUBLIC_KEY_FILE is required'

        candidate_key_id="$4"

        case "$candidate_key_id" in
            *[!A-Za-z0-9_-]*|'')
                fail 'the candidate key ID must be a URL-safe value'
                ;;
        esac

        [ "${#candidate_key_id}" -le 128 ] ||
            fail 'the candidate key ID must be a URL-safe value'

        restore_openclaw_private_key_file="$openclaw_private_key_file"
        restore_application_public_key_file="$public_key_file"
        remember_active_secret \
            "$restore_openclaw_private_key_file" \
            "${temporary_directory}/active-openclaw-private-key"
        remember_active_secret \
            "$restore_application_public_key_file" \
            "${temporary_directory}/active-application-public-key"
        restore_openclaw=true
        restore_application_services='web'
        rotation_started=true

        install_secret "$2" "$openclaw_private_key_file"
        install_secret "$3" "$public_key_file"
        replace_environment_value_in_file \
            "$environment_file" \
            production.env \
            OPENCLAW_CAPABILITY_KEY_ID \
            "$candidate_key_id"
        replace_environment_value_in_file \
            "$openclaw_environment_file" \
            openclaw.env \
            OPENCLAW_MONEY_ASSISTANT_KEY_ID \
            "$candidate_key_id"

        restart_openclaw
        compose up --detach --wait --no-deps --force-recreate web
        openclaw secrets audit --check >/dev/null
        probe_inbound_rotation "$openclaw_private_key_file" "$candidate_key_id"
        ;;
    outbound)
        [ "$#" -eq 2 ] || { usage >&2; exit 64; }
        application_hook_token_file="$(environment_value OPENCLAW_HOOK_TOKEN_FILE)" ||
            fail 'OPENCLAW_HOOK_TOKEN_FILE is required'

        hook_token="$(cat "$2")"

        case "$hook_token" in
            *[!A-Za-z0-9_-]*|'')
                fail 'the candidate hook token must be one long URL-safe value'
                ;;
        esac

        [ "${#hook_token}" -ge 32 ] ||
            fail 'the candidate hook token must be one long URL-safe value'
        configured_hook_url="$(environment_value OPENCLAW_HOOK_URL)" ||
            fail 'OPENCLAW_HOOK_URL is required'
        restore_application_hook_token_file="$application_hook_token_file"
        remember_active_secret \
            "$restore_application_hook_token_file" \
            "${temporary_directory}/active-application-hook-token"

        restore_openclaw=true
        restore_application_services='worker'
        rotation_started=true

        install_secret "$2" "$application_hook_token_file"
        replace_environment_value_in_file \
            "$openclaw_environment_file" \
            openclaw.env \
            OPENCLAW_MONEY_ASSISTANT_HOOK_TOKEN \
            "$hook_token"

        restart_openclaw
        compose up --detach --wait --no-deps --force-recreate worker
        probe_outbound_rotation "$configured_hook_url" "$hook_token"
        ;;
    application)
        [ "$#" -eq 3 ] || { usage >&2; exit 64; }
        application_key_file="$(environment_value APP_KEY_FILE)" ||
            fail 'APP_KEY_FILE is required'
        application_previous_keys_file="$(environment_value APP_PREVIOUS_KEYS_FILE)" ||
            fail 'APP_PREVIOUS_KEYS_FILE is required'

        restore_application_key_file="$application_key_file"
        restore_application_previous_keys_file="$application_previous_keys_file"
        remember_active_secret \
            "$restore_application_key_file" \
            "${temporary_directory}/active-application-key"
        remember_active_secret \
            "$restore_application_previous_keys_file" \
            "${temporary_directory}/active-application-previous-keys"
        restore_application_services='web worker scheduler'
        rotation_started=true
        install_secret "$3" "$application_previous_keys_file"
        install_secret "$2" "$application_key_file"
        compose up --detach --wait --no-deps --force-recreate web worker scheduler
        compose exec --no-TTY web \
            /usr/local/bin/with-production-secrets \
            php artisan app:credentials:rewrap --no-interaction >/dev/null
        rotation_started=false
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac

financial_state_fingerprint > "$financial_state_after"
cmp --silent "$financial_state_before" "$financial_state_after" ||
    fail 'financial state changed during credential rotation'

rotation_complete=true
printf 'Credential rotation rehearsal passed for the %s direction.\n' "$direction"
printf 'CREDENTIAL_ROTATION_DIRECTION direction=%s outcome=passed\n' "$direction"
