#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
systemd_directory="${SYSTEMD_DIRECTORY:-/etc/systemd/system}"
environment_file="${MONITOR_ENVIRONMENT_FILE:-/etc/money-assistant/monitor.env}"

fail()
{
    printf 'Independent monitoring installation failed: %s\n' "$1" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'run this installer as root on the second device'
for required_command in curl flock ssh timeout; do
    command -v "$required_command" >/dev/null 2>&1 || fail "$required_command is required"
done
install -d -m 0700 /etc/money-assistant /var/lib/money-assistant/monitor/independent
if [ ! -e "$environment_file" ]; then
    install -m 0600 "${script_directory}/monitor-independent.env.example" "$environment_file"
    fail "configure ${environment_file} and run the installer again"
fi
chmod 0600 "$environment_file"

set -a
. "$environment_file"
set +a
: "${APPLICATION_MONITOR_KNOWN_HOSTS_FILE:?Set APPLICATION_MONITOR_KNOWN_HOSTS_FILE}"
: "${APPLICATION_MONITOR_SSH_KEY_FILE:?Set APPLICATION_MONITOR_SSH_KEY_FILE}"
: "${MONITOR_TELEGRAM_BOT_TOKEN_FILE:?Set MONITOR_TELEGRAM_BOT_TOKEN_FILE}"
for private_file in "$APPLICATION_MONITOR_SSH_KEY_FILE" "$MONITOR_TELEGRAM_BOT_TOKEN_FILE"; do
    [ -s "$private_file" ] || fail "required private file is empty or unreadable: $private_file"
    chmod 0600 "$private_file"
done
[ -s "$APPLICATION_MONITOR_KNOWN_HOSTS_FILE" ] || fail 'the pinned application-host key file is empty or unreadable'

for script in \
    deliver-independent-monitor-alert \
    deliver-telegram-monitor-alert \
    evaluate-monitoring-incidents \
    monitor-independent-heartbeat; do
    install -m 0755 "${script_directory}/${script}" "/usr/local/sbin/${script}"
done
install -m 0644 "${script_directory}/money-assistant-heartbeat.service" "${systemd_directory}/money-assistant-heartbeat.service"
install -m 0644 "${script_directory}/money-assistant-heartbeat.timer" "${systemd_directory}/money-assistant-heartbeat.timer"

systemctl daemon-reload
systemctl enable --now money-assistant-heartbeat.timer

printf '%s\n' 'Installed the independent heartbeat and direct Telegram fallback.'
