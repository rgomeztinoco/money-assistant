#!/bin/sh

set -eu

openclaw_user="${OPENCLAW_USER:-openclaw}"
openclaw_service="${OPENCLAW_SERVICE:-openclaw-gateway.service}"
candidate_version="${1:-}"
rollback_version="${2:-}"
rehearsal_started=false

usage()
{
    printf '%s\n' 'Usage: rehearse-openclaw-upgrade CANDIDATE_VERSION ROLLBACK_VERSION'
}

fail()
{
    printf 'OpenClaw upgrade rehearsal failed: %s\n' "$1" >&2
    exit 1
}

run_as_openclaw()
{
    user_id="$(id -u "$openclaw_user")"
    openclaw_home="$(getent passwd "$openclaw_user" | cut -d: -f6)"
    [ -n "$openclaw_home" ] || fail 'the OpenClaw service account home could not be resolved'
    runuser --user "$openclaw_user" -- env \
        "HOME=${openclaw_home}" \
        "XDG_RUNTIME_DIR=/run/user/${user_id}" \
        "$@"
}

installed_version()
{
    run_as_openclaw openclaw --version |
        sed -n 's/.*\([0-9][0-9][0-9][0-9]\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' |
        head -n 1
}

install_version()
{
    requested_version="$1"
    run_as_openclaw npm install --global --ignore-scripts --no-audit --no-fund "openclaw@${requested_version}"
}

verify_running_version()
{
    expected_version="$1"
    actual_version="$(installed_version)"
    [ "$actual_version" = "$expected_version" ] ||
        fail "running OpenClaw version ${actual_version:-unknown} does not match $expected_version"
    run_as_openclaw systemctl --user restart "$openclaw_service"
    run_as_openclaw systemctl --user is-active --quiet "$openclaw_service"
    run_as_openclaw openclaw secrets audit --check >/dev/null
}

restore_version()
{
    exit_status="$?"
    if [ "$exit_status" -ne 0 ] && [ "$rehearsal_started" = true ]; then
        install_version "$candidate_version" >/dev/null 2>&1 || true
        verify_running_version "$candidate_version" >/dev/null 2>&1 || true
    fi
    exit "$exit_status"
}

trap restore_version EXIT

[ "$#" -eq 2 ] || {
    usage >&2
    exit 2
}
printf '%s\n' "$candidate_version" | grep -Eq '^[0-9]{4}\.[0-9]+\.[0-9]+$' ||
    fail 'CANDIDATE_VERSION must be a pinned calendar version'
printf '%s\n' "$rollback_version" | grep -Eq '^[0-9]{4}\.[0-9]+\.[0-9]+$' ||
    fail 'ROLLBACK_VERSION must be a pinned calendar version'
[ "$candidate_version" != "$rollback_version" ] ||
    fail 'candidate and rollback OpenClaw versions must differ'
[ "$(id -u)" -eq 0 ] || fail 'run this rehearsal as root'
for required_command in cut env getent id npm runuser sed systemctl; do
    command -v "$required_command" >/dev/null 2>&1 || fail "$required_command is required"
done

active_version="$(installed_version)"
printf '%s\n' "$active_version" | grep -Eq '^[0-9]{4}\.[0-9]+\.[0-9]+$' ||
    fail 'the installed OpenClaw version could not be determined'
[ "$active_version" = "$candidate_version" ] ||
    fail "installed OpenClaw version $active_version is not the active candidate $candidate_version"
rehearsal_started=true

install_version "$rollback_version"
verify_running_version "$rollback_version"

install_version "$candidate_version"
verify_running_version "$candidate_version"
rehearsal_started=false

printf 'OPENCLAW_UPGRADE_REHEARSAL outcome=passed candidate_version=%s rollback_version=%s running_version=%s\n' \
    "$candidate_version" "$rollback_version" "$candidate_version"
