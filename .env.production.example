APP_IMAGE=money-assistant:production
POSTGRES_IMAGE=postgres:18.4-alpine3.23@sha256:996d0920e4ff9df1fc19dacb904492f3c1ec0ec1cc338f0ad7123be7731c5f5e
POSTGRES_IMAGE_PULL_POLICY=always

PRIVATE_HOSTNAME=money-assistant.example.ts.net

GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET_FILE=/etc/money-assistant/secrets/google_gmail_client_secret
GOOGLE_GMAIL_REDIRECT_URI=https://money-assistant.example.ts.net:8443/settings/connections/gmail/callback
GOOGLE_GMAIL_OAUTH_PUBLISHING_STATUS=production

DB_DATABASE=money_assistant
DB_USERNAME=money_assistant
APP_KEY_FILE=/etc/money-assistant/secrets/application_key
APP_PREVIOUS_KEYS_FILE=/etc/money-assistant/secrets/application_previous_keys
DB_PASSWORD_FILE=/etc/money-assistant/secrets/database_password
LOG_LEVEL=info
AUTH_PASSWORD_TIMEOUT=900
SESSION_HTTP_ONLY=true
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
