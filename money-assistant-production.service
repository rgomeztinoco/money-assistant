[Unit]
Description=Money Assistant production application stack
Requires=docker.service
After=docker.service
Before=money-assistant-tailnet.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/money-assistant
TimeoutStartSec=10min
ExecStart=/usr/bin/docker compose --env-file /etc/money-assistant/production.env --file /opt/money-assistant/compose.production.yaml up --detach --wait --pull never
ExecStartPost=/opt/money-assistant/deploy-production verify --env-file /etc/money-assistant/production.env
ExecStop=/usr/bin/docker compose --env-file /etc/money-assistant/production.env --file /opt/money-assistant/compose.production.yaml stop

[Install]
WantedBy=multi-user.target
