[Unit]
Description=Money Assistant production application stack
Requires=docker.service
After=docker.service
Before=money-assistant-tailnet.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/lib/money-assistant/operational-bundles/active
TimeoutStartSec=10min
ExecStart=/usr/bin/docker compose --project-name money-assistant-production --env-file /etc/money-assistant/production.env --file /var/lib/money-assistant/operational-bundles/active/compose.production.yaml up --detach --wait --pull never
ExecStartPost=/var/lib/money-assistant/operational-bundles/active/verify-active-production-release
ExecStop=/usr/bin/docker compose --project-name money-assistant-production --env-file /etc/money-assistant/production.env --file /var/lib/money-assistant/operational-bundles/active/compose.production.yaml stop

[Install]
WantedBy=multi-user.target
