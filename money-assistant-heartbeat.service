[Unit]
Description=Independently monitor Money Assistant heartbeats and recovery jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/money-assistant/monitor.env
ExecStart=/usr/local/sbin/monitor-independent-heartbeat
TimeoutStartSec=75s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/money-assistant/monitor
UMask=0077
