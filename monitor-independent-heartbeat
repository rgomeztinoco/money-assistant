#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
evaluator="${MONITOR_EVALUATOR_COMMAND:-${script_directory}/evaluate-monitoring-incidents}"
direct_delivery_command="${MONITOR_DIRECT_DELIVERY_COMMAND:-${script_directory}/deliver-telegram-monitor-alert}"
primary_delivery_command="${MONITOR_DELIVERY_COMMAND:-${script_directory}/deliver-independent-monitor-alert}"
probe_command="${HEARTBEAT_PROBE_COMMAND:-}"
probe_timeout_seconds="${HEARTBEAT_PROBE_TIMEOUT_SECONDS:-20}"
workspace="$(mktemp -d "${MONITOR_WORK_ROOT:-/tmp}/money-assistant-heartbeat.XXXXXX")"
heartbeat_checks_file="${workspace}/heartbeat-checks"
recovery_checks_file="${workspace}/recovery-checks"

cleanup()
{
    rm -rf -- "$workspace"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

case "$probe_timeout_seconds" in
    ''|*[!0-9]*) printf '%s\n' 'HEARTBEAT_PROBE_TIMEOUT_SECONDS must be an integer.' >&2; exit 2 ;;
esac

if [ -n "$probe_command" ]; then
    heartbeat_output="$($probe_command 2>/dev/null || true)"
else
    : "${APPLICATION_MONITOR_HOST:?Set APPLICATION_MONITOR_HOST}"
    : "${APPLICATION_MONITOR_KNOWN_HOSTS_FILE:?Set APPLICATION_MONITOR_KNOWN_HOSTS_FILE}"
    : "${APPLICATION_MONITOR_SSH_KEY_FILE:?Set APPLICATION_MONITOR_SSH_KEY_FILE}"
    heartbeat_output="$(timeout "$probe_timeout_seconds" ssh \
        -o BatchMode=yes \
        -o ClearAllForwardings=yes \
        -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes \
        -o "UserKnownHostsFile=${APPLICATION_MONITOR_KNOWN_HOSTS_FILE}" \
        -i "$APPLICATION_MONITOR_SSH_KEY_FILE" \
        -T "$APPLICATION_MONITOR_HOST" heartbeat 2>/dev/null || true)"
fi

host_state=failed
application_state=failed
openclaw_state=failed
for heartbeat in $heartbeat_output; do
    case "$heartbeat" in
        host=healthy) host_state=healthy ;;
        application=healthy) application_state=healthy ;;
        openclaw=healthy) openclaw_state=healthy ;;
    esac
done

printf 'host\tcritical\t%s\t300\t%s\n' \
    "$host_state" \
    "$(if [ "$host_state" = healthy ]; then printf '%s' 'Host heartbeat is healthy.'; else printf '%s' 'Host heartbeat has been absent for five minutes. Check host power, networking, and Tailscale from the second device.'; fi)" \
    > "$heartbeat_checks_file"
printf 'application\tcritical\t%s\t300\t%s\n' \
    "$application_state" \
    "$(if [ "$application_state" = healthy ]; then printf '%s' 'Application heartbeat is healthy.'; else printf '%s' 'Application heartbeat has been absent for five minutes. Inspect money-assistant-production.service when the host is reachable.'; fi)" \
    >> "$heartbeat_checks_file"
printf 'openclaw\tcritical\t%s\t300\t%s\n' \
    "$openclaw_state" \
    "$(if [ "$openclaw_state" = healthy ]; then printf '%s' 'OpenClaw heartbeat is healthy.'; else printf '%s' 'OpenClaw heartbeat has been absent for five minutes. Inspect openclaw-gateway.service when the host is reachable.'; fi)" \
    >> "$heartbeat_checks_file"

: > "$recovery_checks_file"

if [ -n "${MONITOR_BACKUP_STATUS_FILE:-}" ]; then
    backup_state=failed
    if [ -r "$MONITOR_BACKUP_STATUS_FILE" ]; then
        backup_result=''
        backup_epoch=''
        read -r backup_result backup_epoch < "$MONITOR_BACKUP_STATUS_FILE" || true
        current_epoch="${MONITOR_NOW_EPOCH:-$(date +%s)}"
        case "$backup_epoch" in
            ''|*[!0-9]*) ;;
            *)
                if [ "$backup_result" = success ] \
                    && [ "$backup_epoch" -le "$current_epoch" ] \
                    && [ $((current_epoch - backup_epoch)) -lt 129600 ]; then
                    backup_state=healthy
                fi
                ;;
        esac
    fi
    printf 'backup\tcritical\t%s\t0\t%s\n' \
        "$backup_state" \
        "$(if [ "$backup_state" = healthy ]; then printf '%s' 'The latest encrypted backup is current.'; else printf '%s' 'The latest encrypted backup failed or is older than 36 hours. Inspect money-assistant-backup-pull.service and its repository.'; fi)" \
        >> "$recovery_checks_file"
fi

if [ -n "${MONITOR_RESTORE_STATUS_FILE:-}" ]; then
    restore_state=failed
    if [ -r "$MONITOR_RESTORE_STATUS_FILE" ]; then
        restore_result=''
        read -r restore_result _restore_epoch < "$MONITOR_RESTORE_STATUS_FILE" || true
        [ "$restore_result" = success ] && restore_state=healthy
    fi
    printf 'restore\tcritical\t%s\t0\t%s\n' \
        "$restore_state" \
        "$(if [ "$restore_state" = healthy ]; then printf '%s' 'The latest restore check passed.'; else printf '%s' 'The latest restore check failed. Inspect the isolated restore logs and rerun the drill after correction.'; fi)" \
        >> "$recovery_checks_file"
fi

exit_status=0
MONITOR_DELIVERY_COMMAND="$direct_delivery_command" \
    "$evaluator" < "$heartbeat_checks_file" || exit_status="$?"
if [ -s "$recovery_checks_file" ]; then
    MONITOR_DELIVERY_COMMAND="$primary_delivery_command" \
        "$evaluator" < "$recovery_checks_file" || exit_status="$?"
fi
exit "$exit_status"
