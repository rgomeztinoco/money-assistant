#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
environment_file="${ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"
state_directory="${DEPLOYMENT_STATE_DIRECTORY:-/var/lib/money-assistant/deployments}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
marker_file="${state_directory}/pending-reboot-rehearsal"
processing_services_stopped=false
reboot_committed=false

usage()
{
    printf '%s\n' 'Usage: rehearse-production-reboot reboot [--env-file PATH]'
    printf '%s\n' '       rehearse-production-reboot verify [--env-file PATH]'
}

fail()
{
    printf 'Production reboot rehearsal failed: %s\n' "$1" >&2
    exit 1
}

compose()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$environment_file" \
        --file "${script_directory}/compose.production.yaml" \
        "$@"
}

cleanup()
{
    if [ "$processing_services_stopped" = true ] && [ "$reboot_committed" = false ]; then
        rm -f -- "$marker_file"
        compose start worker scheduler >/dev/null 2>&1 ||
            printf '%s\n' 'Warning: worker and scheduler could not be restarted.' >&2
    fi
}

verify_service_health()
{
    for service in postgres web worker scheduler proxy; do
        container_id="$(compose ps --quiet "$service")"

        if [ -z "$container_id" ] ||
            [ "$(docker inspect --format '{{.State.Status}}:{{.State.Health.Status}}' "$container_id")" != 'running:healthy' ]; then
            fail "required service is not healthy: $service"
        fi
    done
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$(id -u)" -ne 0 ]; then
    fail 'run this rehearsal as root'
fi

if [ "$#" -lt 1 ]; then
    usage >&2
    exit 2
fi

action="$1"
shift

while [ "$#" -gt 0 ]; do
    case "$1" in
        --env-file)
            [ "$#" -ge 2 ] || fail '--env-file requires a value'
            environment_file="$2"
            shift 2
            ;;
        *)
            usage >&2
            fail "unknown argument: $1"
            ;;
    esac
done

if [ ! -r "$environment_file" ]; then
    fail "environment file is not readable: $environment_file"
fi

command -v flock >/dev/null 2>&1 || fail 'flock is required'
install -d -m 0700 "$state_directory"
exec 9>"${state_directory}/deployment.lock"
flock -n 9 || fail 'a deployment operation is in progress'

case "$action" in
    reboot)
        systemctl is-enabled --quiet money-assistant-production.service ||
            fail 'money-assistant-production.service is not enabled'
        systemctl is-enabled --quiet money-assistant-tailnet.service ||
            fail 'money-assistant-tailnet.service is not enabled'

        rehearsal_id="$(tr -d '\n' < /proc/sys/kernel/random/uuid)"

        processing_services_stopped=true
        compose stop worker scheduler
        compose exec --no-TTY web \
            /usr/local/bin/with-production-secrets \
            php artisan app:deployment-rehearsal:prepare "$rehearsal_id" --no-interaction
        printf '%s\n' "$rehearsal_id" > "$marker_file"
        chmod 0600 "$marker_file"
        sync

        printf '%s\n' 'Durable probes are prepared; rebooting the host now.'

        if systemctl reboot; then
            reboot_committed=true
        else
            fail 'systemd rejected the host reboot'
        fi
        ;;
    verify)
        if [ ! -r "$marker_file" ]; then
            fail 'no pending reboot rehearsal was found'
        fi

        rehearsal_id="$(tr -d '\n' < "$marker_file")"

        systemctl is-active --quiet docker.service tailscaled.service
        systemctl is-active --quiet \
            money-assistant-production.service \
            money-assistant-tailnet.service
        verify_service_health
        "${script_directory}/verify-private-ingress" "$environment_file"
        compose exec --no-TTY web \
            /usr/local/bin/with-production-secrets \
            php artisan app:deployment-rehearsal:verify "$rehearsal_id" --no-interaction

        rm -f -- "$marker_file"
        printf '%s\n' 'Host reboot restored the healthy private path and completed each durable probe exactly once.'
        ;;
    *)
        usage >&2
        fail "unknown action: $action"
        ;;
esac
