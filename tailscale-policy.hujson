{
  "tagOwners": {
    "tag:money-assistant": ["autogroup:owner"],
    "tag:money-assistant-approved-device": ["autogroup:owner"],
  },

  "postures": {
    "posture:approved-owner-device": [
      "node:tsStateEncrypted == true",
      "node:tsReleaseTrack == 'stable'",
      "node:tsVersion >= '1.98.0'",
    ],
  },

  "acls": [
    {
      "action": "accept",
      "src": ["tag:money-assistant-approved-device"],
      "srcPosture": ["posture:approved-owner-device"],
      "dst": ["tag:money-assistant:443"],
    },
  ],

  "tests": [
    {
      "src": "tag:money-assistant-approved-device",
      "srcPostureAttrs": {
        "node:tsStateEncrypted": true,
        "node:tsReleaseTrack": "stable",
        "node:tsVersion": "1.98.0",
      },
      "accept": ["tag:money-assistant:443"],
      "deny": ["tag:money-assistant:80", "tag:money-assistant:8443", "tag:money-assistant:18789"],
    },
    {
      "src": "autogroup:member",
      "deny": ["tag:money-assistant:443", "tag:money-assistant:18789"],
    },
  ],
}
