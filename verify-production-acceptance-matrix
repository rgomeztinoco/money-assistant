#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
state_directory="${DEPLOYMENT_STATE_DIRECTORY:-/var/lib/money-assistant/deployments}"
deployment_record="${state_directory}/current.json"

fail()
{
    printf 'Production acceptance matrix failed: %s\n' "$1" >&2
    exit 1
}

json_value()
{
    requested_key="$1"
    sed -n "s/.*\"${requested_key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$deployment_record" |
        head -n 1
}

cd "$script_directory"
[ -r "$deployment_record" ] || fail "deployment record is not readable: $deployment_record"
active_revision="$(json_value application_revision)"
active_image="$(json_value application_image)"
active_image_id="$(json_value application_image_id)"
checkout_revision="$(git rev-parse HEAD)"
[ -n "$active_revision" ] && [ "$checkout_revision" = "$active_revision" ] ||
    fail 'the checked-out revision does not match the active deployment'
[ -z "$(git status --porcelain --untracked-files=normal)" ] ||
    fail 'the acceptance checkout contains uncommitted or untracked files'

image_identity="$(docker image inspect \
    --format '{{.Id}}|{{index .Config.Labels "org.opencontainers.image.revision"}}' \
    "$active_image")" || fail 'the active application image could not be inspected'
[ "$image_identity" = "${active_image_id}|${active_revision}" ] ||
    fail 'the tested revision does not match the active image identity and revision label'

/usr/local/sbin/verify-production-deployment
vendor/bin/sail composer ci:check
vendor/bin/sail npm run build

printf '%s\n' 'The PostgreSQL, browser, static-analysis, formatting, and build acceptance matrix passed.'
printf '%s\n' 'PRODUCTION_TRUST_EVIDENCE gate=acceptance-matrix outcome=passed'
