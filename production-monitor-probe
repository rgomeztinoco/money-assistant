#!/bin/sh

set -eu

environment_file="${PRODUCTION_ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"
compose_file="${PRODUCTION_COMPOSE_FILE:-/opt/money-assistant/compose.production.yaml}"
project_name="${PRODUCTION_PROJECT_NAME:-money-assistant-production}"
backup_status_file="${MONITOR_BACKUP_STATUS_FILE:-/var/lib/money-assistant/monitor/backup-status}"
credential_deadlines_file="${MONITOR_CREDENTIAL_DEADLINES_FILE:-/etc/money-assistant/credential-deadlines}"
disk_path="${MONITOR_DISK_PATH:-/var/lib/docker}"
now_epoch="${MONITOR_NOW_EPOCH:-$(date +%s)}"

case "$now_epoch" in
    ''|*[!0-9]*) printf '%s\n' 'MONITOR_NOW_EPOCH must be an integer.' >&2; exit 2 ;;
esac

compose()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$environment_file" \
        --file "$compose_file" \
        "$@"
}

service_state()
{
    container_id="$(compose ps --quiet "$1" 2>/dev/null || true)"
    [ -n "$container_id" ] || return 1
    [ "$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id" 2>/dev/null || true)" = healthy ]
}

emit_service()
{
    if service_state "$2"; then
        printf '%s\tcritical\thealthy\t0\t%s is healthy.\n' "$1" "$3"
    else
        printf '%s\tcritical\tfailed\t0\t%s health check failed. Inspect money-assistant-production.service and its container logs.\n' "$1" "$3"
    fi
}

emit_service application web 'Application'
emit_service postgresql postgres 'PostgreSQL'
emit_service worker worker 'Queue worker'
emit_service scheduler scheduler 'Scheduler'

if service_state web; then
    if ! compose exec -T web php artisan app:monitor-snapshot --no-interaction; then
        printf 'application_snapshot\tcritical\tfailed\t0\tApplication monitoring snapshot failed.\n'
    fi
else
    printf 'gmail\twarning\tfailed\t900\tGmail synchronization has been unhealthy for 15 minutes. Restore the application, then inspect Settings > Connections.\n'
fi

backup_state=failed
if [ -r "$backup_status_file" ]; then
    backup_result=''
    backup_epoch=''
    read -r backup_result backup_epoch < "$backup_status_file" || true
    case "$backup_epoch" in
        ''|*[!0-9]*) ;;
        *)
            if [ "$backup_result" = success ] \
                && [ "$backup_epoch" -le "$now_epoch" ] \
                && [ $((now_epoch - backup_epoch)) -lt 129600 ]; then
                backup_state=healthy
            fi
            ;;
    esac
fi
if [ "$backup_state" = healthy ]; then
    printf 'backup\tcritical\thealthy\t0\tThe latest encrypted backup is current.\n'
else
    printf 'backup\tcritical\tfailed\t0\tThe latest encrypted backup failed or is older than 36 hours. Inspect the host export and the second-device backup pull.\n'
fi

disk_percent="$(df -P "$disk_path" 2>/dev/null | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }')"
case "$disk_percent" in
    ''|*[!0-9]*)
        printf 'disk\tcritical\tfailed\t0\tDisk usage could not be measured. Inspect the host filesystem and monitoring permissions.\n'
        ;;
    *)
        if [ "$disk_percent" -ge 90 ]; then
            printf 'disk\tcritical\tfailed\t0\tDisk use is at or above 90 percent. Free space before application writes fail.\n'
        elif [ "$disk_percent" -ge 80 ]; then
            printf 'disk\twarning\tfailed\t0\tDisk use is at or above 80 percent. Review growth and free space.\n'
        else
            printf 'disk\twarning\thealthy\t0\tDisk use is below 80 percent.\n'
        fi
        ;;
esac

credential_state=failed
credential_severity=critical
credential_message='The credential and certificate inventory is missing or invalid. Create a valid deadline inventory and verify monitoring permissions.'
if [ -s "$credential_deadlines_file" ]; then
    credential_inventory_valid=true
    credential_has_entry=false
    credential_state=healthy
    credential_severity=warning
    credential_message='Credentials and certificates have more than 14 days remaining.'
    while IFS=' ' read -r credential_name expires_at || [ -n "$credential_name" ]; do
        [ -n "$credential_name" ] || continue
        case "$credential_name" in
            *[!A-Za-z0-9._-]*) credential_inventory_valid=false; break ;;
        esac
        case "$expires_at" in
            ''|*[!0-9]*) credential_inventory_valid=false; break ;;
        esac
        credential_has_entry=true
        remaining_seconds=$((expires_at - now_epoch))
        if [ "$remaining_seconds" -le 0 ]; then
            credential_state=failed
            credential_severity=critical
            credential_message="Credential or certificate ${credential_name} has expired. Rotate it and rehearse the affected connection."
            break
        fi
        if [ "$remaining_seconds" -le 1209600 ]; then
            credential_state=failed
            credential_message="Credential or certificate ${credential_name} expires within 14 days. Schedule its rotation and rehearsal."
        fi
    done < "$credential_deadlines_file"

    if [ "$credential_inventory_valid" != true ] || [ "$credential_has_entry" != true ]; then
        credential_state=failed
        credential_severity=critical
        credential_message='The credential and certificate inventory is missing or invalid. Create a valid deadline inventory and verify monitoring permissions.'
    fi
fi
printf 'credential\t%s\t%s\t0\t%s\n' \
    "$credential_severity" "$credential_state" "$credential_message"
