#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
systemd_directory="${SYSTEMD_DIRECTORY:-/etc/systemd/system}"
environment_file="${MONITOR_ENVIRONMENT_FILE:-/etc/money-assistant/monitor.env}"

fail()
{
    printf 'Production monitoring installation failed: %s\n' "$1" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'run this installer as root on the application host'
command -v flock >/dev/null 2>&1 || fail 'flock is required'
install -d -m 0700 /etc/money-assistant /var/lib/money-assistant/monitor/primary
if [ ! -e "$environment_file" ]; then
    install -m 0600 "${script_directory}/monitor-host.env.example" "$environment_file"
    fail "configure ${environment_file} and run the installer again"
fi
chmod 0600 "$environment_file"

for script in \
    deliver-telegram-monitor-alert \
    evaluate-monitoring-incidents \
    monitor-production \
    production-heartbeat \
    production-monitor-probe; do
    install -m 0755 "${script_directory}/${script}" "/usr/local/sbin/${script}"
done
install -m 0644 "${script_directory}/money-assistant-monitor.service" "${systemd_directory}/money-assistant-monitor.service"
install -m 0644 "${script_directory}/money-assistant-monitor.timer" "${systemd_directory}/money-assistant-monitor.timer"

systemctl daemon-reload
systemctl enable --now money-assistant-monitor.timer

printf '%s\n' 'Installed the primary Money Assistant production monitor.'
