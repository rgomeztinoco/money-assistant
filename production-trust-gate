#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
state_directory="${DEPLOYMENT_STATE_DIRECTORY:-/var/lib/money-assistant/deployments}"
evidence_directory="${PRODUCTION_TRUST_EVIDENCE_DIRECTORY:-/var/lib/money-assistant/production-trust}"
command_directory="${PRODUCTION_TRUST_COMMAND_DIRECTORY:-$script_directory}"
now_epoch="${PRODUCTION_TRUST_NOW_EPOCH:-$(date +%s)}"
deployment_record="${state_directory}/current.json"
gate_registry='forced-crash 7948800 rehearse-production-crash -
backup-retention 129600 pull-production-backup -
clean-restore 7948800 restore-production-backup -
credential-rotation 7948800 rehearse-all-credential-rotations -
independent-alert 2678400 rehearse-independent-alert -
pinned-upgrade 2678400 rehearse-production-upgrade -
ubuntu-security-updates 129600 verify-production-security-updates -
acceptance-matrix 2678400 verify-production-acceptance-matrix -'

usage()
{
    printf '%s\n' 'Usage: production-trust-gate verify'
    printf '%s\n' '       production-trust-gate run GATE [DRILL_ARGUMENT ...]'
}

fail()
{
    printf 'Production trust gate failed: %s\n' "$1" >&2
    exit 1
}

if [ "$command_directory" != "$script_directory" ] && [ "${PRODUCTION_TRUST_TESTING:-false}" != true ]; then
    fail 'PRODUCTION_TRUST_COMMAND_DIRECTORY is reserved for automated tests'
fi

json_value()
{
    requested_key="$1"
    requested_file="$2"

    sed -n "s/.*\"${requested_key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$requested_file" |
        head -n 1
}

json_integer()
{
    requested_key="$1"
    requested_file="$2"

    sed -n "s/.*\"${requested_key}\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "$requested_file" |
        head -n 1
}

maximum_age_for()
{
    maximum_age="$(printf '%s\n' "$gate_registry" | awk -v requested_gate="$1" '$1 == requested_gate { print $2 }')"
    [ -n "$maximum_age" ] || return 1
    printf '%s\n' "$maximum_age"
}

producer_for_gate()
{
    producer="$(printf '%s\n' "$gate_registry" | awk -v requested_gate="$1" '$1 == requested_gate { print $3 }')"
    [ -n "$producer" ] || return 1
    printf '%s\n' "$producer"
}

producer_argument_for_gate()
{
    producer_argument="$(printf '%s\n' "$gate_registry" | awk -v requested_gate="$1" '$1 == requested_gate { print $4 }')"
    [ -n "$producer_argument" ] || return 1
    printf '%s\n' "$producer_argument"
}

validate_gate()
{
    maximum_age_for "$1" >/dev/null || fail "unknown gate: $1"
}

validate_approved_command()
{
    approved_command="$1"
    [ -f "$approved_command" ] && [ ! -L "$approved_command" ] && [ -x "$approved_command" ] ||
        fail "approved command is not executable: $approved_command"
    if [ "${PRODUCTION_TRUST_TESTING:-false}" != true ]; then
        [ "$(stat --format '%u' "$command_directory")" -eq 0 ] &&
            [ "$(stat --format '%u' "$approved_command")" -eq 0 ] ||
            fail 'approved commands must be owned by root'
        ! find "$command_directory" "$approved_command" -maxdepth 0 -perm /022 -print -quit |
            grep -q . || fail 'approved commands must not be group- or world-writable'
    fi
}

read_active_deployment()
{
    [ -r "$deployment_record" ] || fail "deployment record is not readable: $deployment_record"
    active_application_image="$(json_value application_image "$deployment_record")"
    active_application_revision="$(json_value application_revision "$deployment_record")"
    active_database_image="$(json_value database_image "$deployment_record")"
    active_operational_bundle_checksum="$(json_value operational_bundle_checksum "$deployment_record")"

    printf '%s\n' "$active_application_image" |
        grep -Eq '^.+@sha256:[a-f0-9]{64}$' ||
        fail 'the active application image is not pinned by sha256 digest'
    printf '%s\n' "$active_application_revision" |
        grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$' ||
        fail 'the active application revision is missing or invalid'
    printf '%s\n' "$active_database_image" |
        grep -Eq '^.+@sha256:[a-f0-9]{64}$' ||
        fail 'the active database image is not pinned by sha256 digest'
    printf '%s\n' "$active_operational_bundle_checksum" |
        grep -Eq '^[a-f0-9]{64}$' ||
        fail 'the active operational bundle checksum is missing or invalid'

}

record_gate()
{
    gate="$1"
    proof_file="$2"
    producer="$3"
    read_active_deployment

    [ -f "$proof_file" ] && [ ! -L "$proof_file" ] && [ -s "$proof_file" ] ||
        fail 'proof must be a non-empty regular file'
    grep -Fxq "PRODUCTION_TRUST_EVIDENCE gate=${gate} outcome=passed" "$proof_file" ||
        fail "proof does not attest a passed ${gate} drill"

    install -d -m 0700 "$evidence_directory"
    retained_proof="${evidence_directory}/${gate}.proof"
    install -m 0600 "$proof_file" "$retained_proof"
    proof_sha256="$(sha256sum "$retained_proof" | awk '{ print $1 }')"
    temporary_record="$(mktemp "${evidence_directory}/temporary.XXXXXX")"

    {
        printf '{\n'
        printf '  "gate": "%s",\n' "$gate"
        printf '  "application_image": "%s",\n' "$active_application_image"
        printf '  "application_revision": "%s",\n' "$active_application_revision"
        printf '  "database_image": "%s",\n' "$active_database_image"
        printf '  "operational_bundle_checksum": "%s",\n' "$active_operational_bundle_checksum"
        printf '  "recorded_at_epoch": %s,\n' "$now_epoch"
        printf '  "producer": "%s",\n' "$producer"
        printf '  "proof_sha256": "%s"\n' "$proof_sha256"
        printf '}\n'
    } > "$temporary_record"

    install -m 0600 "$temporary_record" "${evidence_directory}/${gate}.json"
    rm -f -- "$temporary_record"
    printf 'Recorded %s proof for deployment revision %s.\n' "$gate" "$active_application_revision"
}

run_gate()
{
    gate="$1"
    shift
    validate_gate "$gate"

    producer="$(producer_for_gate "$gate")"
    producer_argument="$(producer_argument_for_gate "$gate")"
    if [ "$producer_argument" != '-' ]; then
        set -- "$producer_argument" "$@"
    fi

    drill_command="${command_directory}/${producer}"
    validate_approved_command "$drill_command"

    install -d -m 0700 "$evidence_directory"
    temporary_proof="$(mktemp "${evidence_directory}/proof.XXXXXX")"
    if ! PRODUCTION_TRUST_GATE="$gate" "$drill_command" "$@" > "$temporary_proof" 2>&1; then
        cat "$temporary_proof" >&2
        rm -f -- "$temporary_proof"
        fail "approved ${gate} drill failed"
    fi

    cat "$temporary_proof"
    record_gate "$gate" "$temporary_proof" "$producer"
    rm -f -- "$temporary_proof"
}

write_status()
{
    trust_state="$1"
    install -d -m 0700 "$evidence_directory"
    temporary_status="$(mktemp "${evidence_directory}/status.XXXXXX")"
    printf '%s %s %s\n' "$trust_state" "$active_application_revision" "$now_epoch" > "$temporary_status"
    install -m 0600 "$temporary_status" "${evidence_directory}/status"
    rm -f -- "$temporary_status"
}

verify_gate()
{
    gate="$1"
    evidence_file="${evidence_directory}/${gate}.json"
    maximum_age="$(maximum_age_for "$gate")"

    if [ ! -r "$evidence_file" ]; then
        printf 'MISSING %s: no deployment proof was recorded.\n' "$gate"
        return 1
    fi

    recorded_gate="$(json_value gate "$evidence_file")"
    recorded_image="$(json_value application_image "$evidence_file")"
    recorded_revision="$(json_value application_revision "$evidence_file")"
    recorded_database_image="$(json_value database_image "$evidence_file")"
    recorded_operational_bundle_checksum="$(json_value operational_bundle_checksum "$evidence_file")"
    recorded_at_epoch="$(json_integer recorded_at_epoch "$evidence_file")"
    recorded_producer="$(json_value producer "$evidence_file")"
    proof_sha256="$(json_value proof_sha256 "$evidence_file")"

    if [ "$recorded_gate" != "$gate" ] ||
        [ "$recorded_image" != "$active_application_image" ] ||
        [ "$recorded_revision" != "$active_application_revision" ] ||
        [ "$recorded_database_image" != "$active_database_image" ] ||
        [ "$recorded_operational_bundle_checksum" != "$active_operational_bundle_checksum" ] ||
        [ "$recorded_producer" != "$(producer_for_gate "$gate")" ]; then
        printf 'STALE %s: proof does not match the active deployment.\n' "$gate"
        return 1
    fi

    case "$recorded_at_epoch" in
        '' | *[!0-9]*)
            printf 'INVALID %s: proof timestamp is invalid.\n' "$gate"
            return 1
            ;;
    esac
    printf '%s\n' "$proof_sha256" | grep -Eq '^[a-f0-9]{64}$' || {
        printf 'INVALID %s: proof digest is invalid.\n' "$gate"
        return 1
    }

    retained_proof="${evidence_directory}/${gate}.proof"
    if [ ! -f "$retained_proof" ] || [ -L "$retained_proof" ] ||
        [ "$(sha256sum "$retained_proof" | awk '{ print $1 }')" != "$proof_sha256" ]; then
        printf 'INVALID %s: retained proof digest does not match.\n' "$gate"
        return 1
    fi
    grep -Fxq "PRODUCTION_TRUST_EVIDENCE gate=${gate} outcome=passed" "$retained_proof" || {
        printf 'INVALID %s: retained proof does not attest a passed drill.\n' "$gate"
        return 1
    }

    if [ "$recorded_at_epoch" -gt "$now_epoch" ] ||
        [ $((now_epoch - recorded_at_epoch)) -gt "$maximum_age" ]; then
        printf 'STALE %s: proof is outside its required rehearsal interval.\n' "$gate"
        return 1
    fi

    printf 'PASS %s\n' "$gate"
}

case "$now_epoch" in
    '' | *[!0-9]*) fail 'PRODUCTION_TRUST_NOW_EPOCH must be an integer' ;;
esac

[ "$#" -ge 1 ] || {
    usage >&2
    exit 2
}

action="$1"
shift

case "$action" in
    run)
        [ "$#" -ge 1 ] || {
            usage >&2
            exit 2
        }
        run_gate "$@"
        ;;
    verify)
        [ "$#" -eq 0 ] || {
            usage >&2
            exit 2
        }
        read_active_deployment
        all_gates_passed=true
        for gate in $(printf '%s\n' "$gate_registry" | awk '{ print $1 }'); do
            verify_gate "$gate" || all_gates_passed=false
        done

        if [ "$all_gates_passed" = true ]; then
            write_status trusted
            printf 'Production trust: TRUSTED for revision %s.\n' "$active_application_revision"
            exit 0
        fi

        write_status withheld
        printf 'Production trust: WITHHELD for revision %s.\n' "$active_application_revision"
        exit 1
        ;;
    *)
        usage >&2
        fail "unknown action: $action"
        ;;
esac
