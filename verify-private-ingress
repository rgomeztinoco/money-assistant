#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
environment_file="${1:-.env.production}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"

fail()
{
    printf 'Private ingress verification failed: %s\n' "$1" >&2
    exit 1
}

if [ "$(id -u)" -ne 0 ]; then
    fail 'run this verifier as root so firewall state can be inspected'
fi

if [ ! -r "$environment_file" ]; then
    fail "environment file is not readable: $environment_file"
fi

set -a
. "$environment_file"
set +a

: "${PRIVATE_HOSTNAME:?PRIVATE_HOSTNAME is required}"

tailscale_status="$(tailscale status --json)"

printf '%s' "$tailscale_status" |
    jq -e '.BackendState == "Running"' >/dev/null ||
    fail 'Tailscale must be running'

serve_status="$(tailscale serve status --json)"

printf '%s' "$serve_status" |
    jq -e \
        --arg host_port "${PRIVATE_HOSTNAME}:8443" '
        .TCP["8443"].HTTPS == true
        and .Web[$host_port].Handlers["/"].Proxy == "http://127.0.0.1:8443"
        and ((.Web[$host_port].Handlers | keys) == ["/"])
    ' >/dev/null || fail 'Tailscale Serve does not exclusively route HTTPS to the loopback proxy'

funnel_status="$(tailscale funnel status --json)"

printf '%s' "$funnel_status" |
    jq -e '[(.AllowFunnel // {})[]] | all(. == false)' >/dev/null ||
    fail 'Tailscale Funnel must remain disabled'

ufw_status="$(ufw status verbose)"

printf '%s' "$ufw_status" | awk '
    /^Status: active$/ { active = 1 }
    /^Default: deny \(incoming\)/ { default_deny = 1 }
    END { exit !(active && default_deny) }
' || fail 'UFW must be active with default-deny incoming policy'

ufw_rules="$(ufw show added)"

printf '%s' "$ufw_rules" | awk '
    /^ufw allow/ && /(^|[[:space:]])(80|443|5432|8443)(\/tcp)?([[:space:]]|$)/ && $0 !~ / on tailscale0 / { exit 1 }
' || fail 'UFW explicitly allows an application port outside tailscale0'

compose_status="$(docker compose \
    --project-name "$project_name" \
    --env-file "$environment_file" \
    --file "${script_directory}/compose.production.yaml" \
    config --format json)"

printf '%s' "$compose_status" | jq -e '
    .services.proxy.ports == [{
        host_ip: "127.0.0.1",
        mode: "ingress",
        protocol: "tcp",
        published: "8443",
        target: 8080
    }]
    and ([.services | to_entries[] | select(.key != "proxy") | .value.ports // []] | all(length == 0))
' >/dev/null || fail 'Compose publishes an application port outside loopback'

listeners="$(ss -H -lnt)"
tailnet_ips="$(printf '%s' "$tailscale_status" | jq -r '.TailscaleIPs | join(" ")')"

if [ -z "$tailnet_ips" ]; then
    fail 'the host has no tailnet IP address'
fi

printf '%s\n' "$listeners" | awk -v tailnet_ips="$tailnet_ips" '
    BEGIN {
        allowed["127.0.0.1:80"] = 1
        allowed["127.0.0.1:5432"] = 1
        allowed["127.0.0.1:8080"] = 1
        allowed["127.0.0.1:8443"] = 1
        allowed["[::1]:80"] = 1
        allowed["[::1]:5432"] = 1
        allowed["[::1]:8080"] = 1
        allowed["[::1]:8443"] = 1

        address_count = split(tailnet_ips, addresses, " ")
        for (address_index = 1; address_index <= address_count; address_index++) {
            allowed[addresses[address_index] ":8443"] = 1
            allowed["[" addresses[address_index] "]:8443"] = 1
        }
    }
    $4 ~ /:(80|5432|8080|8443)$/ && !($4 in allowed) { exit 1 }
' || fail 'an application listener is reachable outside its approved private interface'

curl \
    --fail \
    --silent \
    --show-error \
    "https://${PRIVATE_HOSTNAME}:8443/up" \
    >/dev/null || fail 'tailnet HTTPS health probe failed'

printf 'Private ingress verification passed.\n'
