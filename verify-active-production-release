#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
active_link="${OPERATIONAL_BUNDLE_ACTIVE_LINK:-/var/lib/money-assistant/operational-bundles/active}"
environment_file="${PRODUCTION_ENV_FILE:-/etc/money-assistant/production.env}"
source_revision="$(tr -d '\n' < "${script_directory}/SOURCE_REVISION")"
bundle_checksum="$(basename -- "$script_directory")"
resolved_active_directory="$(CDPATH= cd -- "$active_link" && pwd -P)"

fail()
{
    printf 'Active production release verification failed: %s\n' "$1" >&2
    exit 1
}

[ "$resolved_active_directory" = "$script_directory" ] || fail 'active bundle link does not select this release'
printf '%s\n' "$source_revision" | grep -Eq '^[a-f0-9]{40}$' || fail 'active source revision is invalid'
printf '%s\n' "$bundle_checksum" | grep -Eq '^[a-f0-9]{64}$' || fail 'active bundle checksum is invalid'
[ -f "$environment_file" ] && [ ! -L "$environment_file" ] || fail 'production environment is unavailable'

export OPERATIONAL_BUNDLE_CHECKSUM="$bundle_checksum"
export OPERATIONAL_BUNDLE_REVISION="$source_revision"
export OPERATIONAL_BUNDLE_DIRECTORY="$script_directory"
export OPERATIONAL_BUNDLE_ACTIVE_LINK="$active_link"
export COMPOSE_FILE="${script_directory}/compose.production.yaml"

exec "${script_directory}/deploy-production" verify --env-file "$environment_file"
