MONITOR_STATE_DIRECTORY=/var/lib/money-assistant/monitor/primary
MONITOR_DELIVERY_COMMAND=/usr/local/sbin/deliver-openclaw-monitor-alert
MONITOR_OPENCLAW_USER=openclaw
MONITOR_OPENCLAW_ACCOUNT_ID=money-assistant-owner
MONITOR_OPENCLAW_OWNER_SENDER_ID=123456789
MONITOR_BACKUP_STATUS_FILE=/var/lib/money-assistant/monitor/backup-status
MONITOR_CREDENTIAL_DEADLINES_FILE=/etc/money-assistant/credential-deadlines
MONITOR_DISK_PATH=/var/lib/docker
