MONITOR_STATE_DIRECTORY=/var/lib/money-assistant/monitor/primary
MONITOR_DELIVERY_COMMAND=/usr/local/sbin/deliver-telegram-monitor-alert
MONITOR_TELEGRAM_BOT_TOKEN_FILE=/etc/money-assistant/secrets/monitor_telegram_bot_token
