MONITOR_BACKUP_STATUS_FILE=/var/lib/money-assistant/monitor/backup-status
MONITOR_CREDENTIAL_DEADLINES_FILE=/etc/money-assistant/credential-deadlines
MONITOR_DISK_PATH=/var/lib/docker
