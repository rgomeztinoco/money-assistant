#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
monitor_user="${MONITOR_EXPORT_USER:-money-assistant-monitor}"
monitor_home="${MONITOR_EXPORT_HOME:-/home/${monitor_user}}"

fail()
{
    printf 'Production heartbeat installation failed: %s\n' "$1" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'run this installer as root on the application host'
[ "$#" -eq 1 ] || fail 'usage: install-production-heartbeat SSH_PUBLIC_KEY_FILE'
ssh_public_key_file="$1"
[ -r "$ssh_public_key_file" ] || fail "SSH public key is not readable: $ssh_public_key_file"
ssh_public_key="$(cat "$ssh_public_key_file")"
printf '%s\n' "$ssh_public_key" | awk '
    NR == 1 && NF >= 2 && $1 == "ssh-ed25519" && $2 ~ /^[A-Za-z0-9+\/=]+$/ { valid = 1 }
    END { exit ! (valid && NR == 1) }
' || fail 'the monitoring device must use an ssh-ed25519 public key'

if ! id "$monitor_user" >/dev/null 2>&1; then
    useradd --create-home --home-dir "$monitor_home" --shell /bin/sh --user-group "$monitor_user"
fi
usermod --lock --home "$monitor_home" --shell /bin/sh "$monitor_user"
for script in production-heartbeat production-monitor-relay route-production-monitor-request; do
    install -m 0755 "${script_directory}/${script}" "/usr/local/sbin/${script}"
done
install -d -m 0700 -o "$monitor_user" -g "$monitor_user" "${monitor_home}/.ssh"
printf 'restrict,command="/usr/local/sbin/route-production-monitor-request" %s\n' "$ssh_public_key" \
    > "${monitor_home}/.ssh/authorized_keys"
chown "$monitor_user:$monitor_user" "${monitor_home}/.ssh/authorized_keys"
chmod 0600 "${monitor_home}/.ssh/authorized_keys"
printf '%s ALL=(root) NOPASSWD: /usr/local/sbin/production-heartbeat, /usr/local/sbin/production-monitor-relay\n' "$monitor_user" \
    > /etc/sudoers.d/money-assistant-monitor
chmod 0440 /etc/sudoers.d/money-assistant-monitor
visudo --check --file=/etc/sudoers.d/money-assistant-monitor >/dev/null

printf '%s\n' 'Installed the narrow, read-only production heartbeat command.'
