OPENCLAW_PROFILE=money-assistant-production
OPENCLAW_STATE_DIR=/home/openclaw/.openclaw-money-assistant-production
OPENCLAW_CONFIG_PATH=/opt/money-assistant/openclaw/money-assistant-agent-policy.json
OPENCLAW_GATEWAY_PORT=19789
TELEGRAM_BOT_TOKEN=

OPENCLAW_MONEY_ASSISTANT_KEY_ID=openclaw-service-production
OPENCLAW_MONEY_ASSISTANT_CAPABILITY_ORIGIN=http://127.0.0.1:8443
OPENCLAW_MONEY_ASSISTANT_PRIVATE_KEY_FILE=/etc/money-assistant/secrets/openclaw_capability_private_key
OPENCLAW_MONEY_ASSISTANT_PLUGIN_PATH=/opt/money-assistant/openclaw/money-assistant-plugin
OPENCLAW_MONEY_ASSISTANT_ACCOUNT_ID=money-assistant-owner
OPENCLAW_MONEY_ASSISTANT_OWNER_SENDER_ID=
OPENCLAW_MONEY_ASSISTANT_HOOK_TOKEN=
OPENCLAW_MONEY_ASSISTANT_WORKSPACE=/home/openclaw/.openclaw-money-assistant-production/workspace
OPENCLAW_MONEY_ASSISTANT_RECEIPT_MEDIA_ROOT=/home/openclaw/.openclaw-money-assistant-production/receipts
OPENCLAW_MONEY_ASSISTANT_OPENAI_OAUTH_CREDENTIAL_VERSION=production-v1
