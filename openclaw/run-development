#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
environment_file="${OPENCLAW_DEVELOPMENT_ENV_FILE:-${script_directory}/development.env}"

fail()
{
    printf 'Development OpenClaw failed: %s\n' "$1" >&2
    exit 1
}

[ -r "$environment_file" ] || fail "copy development.env.example to development.env and configure its isolated credentials"

set -a
# shellcheck disable=SC1090
. "$environment_file"
set +a

[ "${OPENCLAW_PROFILE:-}" = money-assistant-development ] || fail 'OPENCLAW_PROFILE must target development'
[ "${OPENCLAW_GATEWAY_PORT:-}" = 29789 ] || fail 'OPENCLAW_GATEWAY_PORT must remain isolated on 29789'
[ "${OPENCLAW_MONEY_ASSISTANT_ACCOUNT_ID:-}" = money-assistant-development ] || fail 'the development OpenClaw account is required'
[ "${OPENCLAW_MONEY_ASSISTANT_CAPABILITY_ORIGIN:-}" = http://127.0.0.1:8080 ] || fail 'capabilities must target the loopback development application'
[ -n "${OPENCLAW_STATE_DIR:-}" ] || fail 'OPENCLAW_STATE_DIR is required'
[ -n "${OPENCLAW_MONEY_ASSISTANT_PRIVATE_KEY_FILE:-}" ] || fail 'a development capability private key is required'
[ -n "${TELEGRAM_BOT_TOKEN:-}" ] || fail 'a separate development Telegram bot token is required'

OPENCLAW_CONFIG_PATH="${OPENCLAW_CONFIG_PATH:-${script_directory}/money-assistant-agent-policy.json}"
OPENCLAW_MONEY_ASSISTANT_PLUGIN_PATH="${OPENCLAW_MONEY_ASSISTANT_PLUGIN_PATH:-${script_directory}/money-assistant-plugin}"
export OPENCLAW_CONFIG_PATH OPENCLAW_MONEY_ASSISTANT_PLUGIN_PATH

exec openclaw gateway --port "$OPENCLAW_GATEWAY_PORT"
