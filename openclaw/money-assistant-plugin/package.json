{
  "name": "@money-assistant/openclaw-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm run types:check && npm test && npm run validate",
    "test": "npm run build && node --test dist/index.test.js",
    "types:check": "tsc --noEmit",
    "validate": "openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  }
}
