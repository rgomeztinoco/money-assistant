{
  "plugins": {
    "enabled": true,
    "allow": [
      "telegram",
      "money-assistant"
    ],
    "load": {
      "paths": [
        "/opt/money-assistant/openclaw/money-assistant-plugin"
      ]
    },
    "entries": {
      "money-assistant": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "keyId": "${OPENCLAW_MONEY_ASSISTANT_KEY_ID}",
          "privateKey": "${OPENCLAW_MONEY_ASSISTANT_PRIVATE_KEY}",
          "agentId": "money-assistant",
          "accountId": "${OPENCLAW_MONEY_ASSISTANT_ACCOUNT_ID}",
          "conversationId": "${OPENCLAW_MONEY_ASSISTANT_OWNER_SENDER_ID}",
          "ownerSenderId": "${OPENCLAW_MONEY_ASSISTANT_OWNER_SENDER_ID}",
          "receiptMediaRoot": "${OPENCLAW_MONEY_ASSISTANT_RECEIPT_MEDIA_ROOT}",
          "receiptProcessingEnabled": false,
          "receiptDisclosureDelivered": false,
          "receiptDisclosureAccepted": false,
          "openAiModelImprovementDisabled": false,
          "codexFullEnvironmentTrainingDisabled": false,
          "openAiOAuthProfileId": "openai:money-assistant-oauth",
          "openAiOAuthCredentialVersion": "${OPENCLAW_MONEY_ASSISTANT_OPENAI_OAUTH_CREDENTIAL_VERSION}",
          "receiptPolicyVersion": "openai-oauth-gpt-5.6-sol-v1",
          "receiptConfirmedPolicyVersion": "",
          "receiptConfirmedOAuthProfileId": "",
          "receiptConfirmedOAuthCredentialVersion": ""
        }
      }
    }
  },
  "auth": {
    "profiles": {
      "openai:money-assistant-oauth": {
        "provider": "openai",
        "mode": "oauth",
        "displayName": "Existing Money Assistant OpenAI OAuth account"
      }
    },
    "order": {
      "openai": [
        "openai:money-assistant-oauth"
      ]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-sol",
        "fallbacks": []
      },
      "models": {
        "openai/gpt-5.6-sol": {}
      },
      "imageModel": {
        "primary": "openai/gpt-5.6-sol",
        "fallbacks": []
      },
      "mediaGenerationAutoProviderFallback": false,
      "timeoutSeconds": 1800
    },
    "list": [
      {
        "id": "money-assistant",
        "name": "Money Assistant",
        "workspace": "~/.openclaw/workspace-money-assistant",
        "model": {
          "primary": "openai/gpt-5.6-sol",
          "fallbacks": []
        },
        "skills": [],
        "memorySearch": {
          "enabled": false
        },
        "heartbeat": {
          "every": "0m",
          "target": "none"
        },
        "tools": {
          "allow": [
            "money_assistant_transaction_read",
            "money_assistant_transaction_prepare",
            "money_assistant_transaction_confirm",
            "money_assistant_category_read",
            "money_assistant_category_prepare",
            "money_assistant_category_confirm",
            "money_assistant_receipt_proposal_submit",
            "money_assistant_receipt_breakdown_prepare",
            "money_assistant_receipt_breakdown_confirm",
            "money_assistant_reminder_read",
            "money_assistant_reminder_respond"
          ]
        }
      }
    ]
  },
  "commands": {
    "native": false,
    "nativeSkills": false,
    "text": false,
    "bash": false,
    "config": false,
    "mcp": false,
    "plugins": false,
    "debug": false,
    "restart": false
  },
  "bindings": [
    {
      "agentId": "money-assistant",
      "match": {
        "channel": "telegram",
        "accountId": "${OPENCLAW_MONEY_ASSISTANT_ACCOUNT_ID}",
        "peer": {
          "kind": "direct",
          "id": "${OPENCLAW_MONEY_ASSISTANT_OWNER_SENDER_ID}"
        }
      }
    }
  ],
  "channels": {
    "telegram": {
      "defaultAccount": "${OPENCLAW_MONEY_ASSISTANT_ACCOUNT_ID}",
      "actions": {
        "sendMessage": true,
        "deleteMessage": true
      }
    }
  },
  "logging": {
    "level": "warn",
    "consoleLevel": "warn",
    "redactSensitive": "tools"
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_MONEY_ASSISTANT_HOOK_TOKEN}",
    "path": "/hooks",
    "allowedAgentIds": [
      "money-assistant"
    ],
    "allowRequestSessionKey": false,
    "mappings": [
      {
        "id": "money-assistant-reminders",
        "match": {
          "path": "money-assistant"
        },
        "action": "agent",
        "agentId": "money-assistant",
        "wakeMode": "now",
        "name": "Money Assistant Reminder",
        "sessionKey": "hook:money-assistant:reminders",
        "messageTemplate": "Fetch Reminder event {{event_id}} that occurred at {{occurred_at}} with money_assistant_reminder_read. If channel_delivered_at is already set, return NO_REPLY. Otherwise deliver one concise owner-visible digest. Do not treat delivery as acknowledgement or resolution.",
        "deliver": true,
        "channel": "telegram",
        "to": "${OPENCLAW_MONEY_ASSISTANT_OWNER_SENDER_ID}",
        "timeoutSeconds": 300
      }
    ]
  }
}
