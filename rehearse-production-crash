#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
environment_file="${ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"
state_directory="${DEPLOYMENT_STATE_DIRECTORY:-/var/lib/money-assistant/deployments}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
probe_id=''
hold_marker=''
started_marker=''
processing_services_stopped=false

fail()
{
    printf 'Production crash rehearsal failed: %s\n' "$1" >&2
    exit 1
}

compose()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$environment_file" \
        --file "${script_directory}/compose.production.yaml" \
        "$@"
}

remove_crash_markers()
{
    [ -n "$probe_id" ] || return 0
    compose exec --no-TTY web rm -f \
        "/app/storage/app/private/${hold_marker}" \
        "/app/storage/app/private/${started_marker}" \
        >/dev/null 2>&1 || true
}

release_crash_hold()
{
    compose exec --no-TTY web rm -f \
        "/app/storage/app/private/${hold_marker}" \
        >/dev/null 2>&1 || true
}

cleanup()
{
    remove_crash_markers
    if [ "$processing_services_stopped" = true ]; then
        compose up --detach worker scheduler >/dev/null 2>&1 || true
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

[ "$(id -u)" -eq 0 ] || fail 'run this rehearsal as root'
[ -r "$environment_file" ] || fail "environment file is not readable: $environment_file"
command -v docker >/dev/null 2>&1 || fail 'docker is required'
command -v flock >/dev/null 2>&1 || fail 'flock is required'

install -d -m 0700 "$state_directory"
exec 9>"${state_directory}/deployment.lock"
flock -n 9 || fail 'a deployment operation is in progress'

rehearsal_id="$(tr -d '\n' < /proc/sys/kernel/random/uuid)"

processing_services_stopped=true
compose stop worker scheduler
prepare_output="$(compose exec --no-TTY web \
    /usr/local/bin/with-production-secrets \
    php artisan app:deployment-rehearsal:prepare "$rehearsal_id" \
        --hold-for-crash \
        --no-interaction)"
probe_id="$(printf '%s\n' "$prepare_output" | sed -n 's/^Queued probe identifier: //p')"
hold_marker="$(printf '%s\n' "$prepare_output" | sed -n 's/^Crash hold marker: //p')"
started_marker="$(printf '%s\n' "$prepare_output" | sed -n 's/^Crash start marker: //p')"
printf '%s\n' "$probe_id" | grep -Eq '^[a-f0-9-]{36}$' ||
    fail 'the queued crash probe identifier was not returned'
printf '%s\n' "$hold_marker" | grep -Eq "^deployment-crash-rehearsals/${probe_id}\.hold$" ||
    fail 'the queued crash hold marker was not returned'
printf '%s\n' "$started_marker" | grep -Eq "^deployment-crash-rehearsals/${probe_id}\.started$" ||
    fail 'the queued crash start marker was not returned'

compose start worker
probe_started=false
for _attempt in $(seq 1 30); do
    if compose exec --no-TTY web test -f \
        "/app/storage/app/private/${started_marker}"; then
        probe_started=true
        break
    fi
    sleep 1
done
[ "$probe_started" = true ] || fail 'the queued probe did not begin processing'

worker_container_id="$(compose ps --quiet worker)"
[ -n "$worker_container_id" ] || fail 'the queue worker container is missing'
docker kill --signal KILL "$worker_container_id" >/dev/null
release_crash_hold
compose up --detach worker scheduler >/dev/null

catch_up_completed=false
for _attempt in $(seq 1 120); do
    if compose exec --no-TTY web \
        /usr/local/bin/with-production-secrets \
        php artisan app:deployment-rehearsal:verify "$rehearsal_id" --no-interaction \
        >/dev/null 2>&1; then
        catch_up_completed=true
        break
    fi
    sleep 2
done
[ "$catch_up_completed" = true ] || fail 'durable processing did not catch up after the forced crash'

manual_replay_output="$(compose exec --no-TTY web \
    /usr/local/bin/with-production-secrets \
    php artisan app:rehearse-manual-replay --no-interaction)"
printf '%s\n' "$manual_replay_output"
printf '%s\n' "$manual_replay_output" |
    grep -Fxq 'MANUAL_REPLAY_REHEARSAL outcome=passed' ||
    fail 'the target deployment manual replay rehearsal did not pass'

processing_services_stopped=false
printf '%s\n' 'Forced worker crash caught up and completed each durable probe exactly once with one voided rehearsal Transaction.'
printf '%s\n' 'PRODUCTION_TRUST_EVIDENCE gate=forced-crash outcome=passed'
