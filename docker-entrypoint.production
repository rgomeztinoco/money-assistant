#!/bin/sh

set -eu

read_secret()
{
    variable_name="$1"
    secret_file="$2"

    if [ ! -r "$secret_file" ]; then
        echo "Required secret file is not readable: $secret_file" >&2
        exit 1
    fi

    secret_value="$(cat "$secret_file")"

    if [ -z "$secret_value" ]; then
        echo "Required secret file is empty: $secret_file" >&2
        exit 1
    fi

    export "$variable_name=$secret_value"
}

read_optional_secret()
{
    variable_name="$1"
    secret_file="$2"

    if [ ! -r "$secret_file" ]; then
        echo "Optional secret file is not readable: $secret_file" >&2
        exit 1
    fi

    secret_value="$(cat "$secret_file")"

    if [ -n "$secret_value" ]; then
        export "$variable_name=$secret_value"
    fi
}

umask 0027

read_secret APP_KEY "${APP_KEY_FILE:?APP_KEY_FILE is required}"
read_optional_secret APP_PREVIOUS_KEYS "${APP_PREVIOUS_KEYS_FILE:?APP_PREVIOUS_KEYS_FILE is required}"
read_secret DB_PASSWORD "${DB_PASSWORD_FILE:?DB_PASSWORD_FILE is required}"

if [ -n "${GOOGLE_GMAIL_CLIENT_SECRET_FILE:-}" ]; then
    read_secret GOOGLE_GMAIL_CLIENT_SECRET "$GOOGLE_GMAIL_CLIENT_SECRET_FILE"
fi

if [ "$(id -u)" -eq 0 ]; then
    exec setpriv \
        --reuid=33 \
        --regid=33 \
        --init-groups \
        -- "$@"
fi

exec "$@"
