#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
compose_file="${COMPOSE_FILE:-${script_directory}/compose.production.yaml}"
environment_file="${ENVIRONMENT_FILE:-${script_directory}/.env.production}"
state_directory="${DEPLOYMENT_STATE_DIRECTORY:-/var/lib/money-assistant/deployments}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
monitor_environment_file="${MONITOR_ENVIRONMENT_FILE:-/etc/money-assistant/monitor.env}"
requested_application_image=''
temporary_files=''
previous_environment=''
candidate_environment=''
active_candidate_environment=''
rollback_snapshot=''
snapshot_verified=false
database_may_have_changed=false
current_application_image=''
candidate_application_image=''
maintenance_started_epoch=0
maintenance_active=false
rollback_attempted=false
had_previous_release=false
deployment_started=false
deployment_alert_command="${DEPLOYMENT_ALERT_COMMAND:-}"
deployment_activation_marker='/app/storage/framework/deployment-activated'
operational_bundle_checksum="${OPERATIONAL_BUNDLE_CHECKSUM:-$(sha256sum "$compose_file" | awk '{ print $1 }')}"
operational_bundle_revision="${OPERATIONAL_BUNDLE_REVISION:-legacy-host-bundle}"
operational_bundle_directory="${OPERATIONAL_BUNDLE_DIRECTORY:-$script_directory}"
operational_bundle_active_link="${OPERATIONAL_BUNDLE_ACTIVE_LINK:-}"
previous_operational_bundle=''
previous_operational_bundle_absent=false
operational_bundle_activated=false
current_operational_bundle_checksum="$operational_bundle_checksum"
current_operational_bundle_revision="$operational_bundle_revision"
interrupted_candidate_completed=false

usage()
{
    printf '%s\n' 'Usage: deploy-production deploy [--app-image REPOSITORY@sha256:DIGEST] [--env-file PATH]'
    printf '%s\n' '       deploy-production rollback [--env-file PATH]'
    printf '%s\n' '       deploy-production verify [--env-file PATH]'
}

fail()
{
    printf 'Production deployment failed: %s\n' "$1" >&2
    exit 1
}

record_deployment_phase()
{
    phase="$1"
    phase_file="${state_directory}/transaction.state"
    new_temporary_file
    temporary_phase="$temporary_file"
    printf 'phase=%s\n' "$phase" > "$temporary_phase"
    printf 'source_revision=%s\n' "$operational_bundle_revision" >> "$temporary_phase"
    printf 'application_image=%s\n' "$candidate_application_image" >> "$temporary_phase"
    printf 'operational_bundle_checksum=%s\n' "$operational_bundle_checksum" >> "$temporary_phase"
    printf 'previous_environment=%s\n' "$previous_environment" >> "$temporary_phase"
    printf 'candidate_environment=%s\n' "$candidate_environment" >> "$temporary_phase"
    printf 'active_candidate_environment=%s\n' "$active_candidate_environment" >> "$temporary_phase"
    printf 'rollback_snapshot=%s\n' "$rollback_snapshot" >> "$temporary_phase"
    printf 'current_application_image=%s\n' "$current_application_image" >> "$temporary_phase"
    printf 'had_previous_release=%s\n' "$had_previous_release" >> "$temporary_phase"
    printf 'database_may_have_changed=%s\n' "$database_may_have_changed" >> "$temporary_phase"
    printf 'snapshot_verified=%s\n' "$snapshot_verified" >> "$temporary_phase"
    printf 'maintenance_started_epoch=%s\n' "$maintenance_started_epoch" >> "$temporary_phase"
    printf 'previous_operational_bundle=%s\n' "${previous_operational_bundle:-__absent__}" >> "$temporary_phase"
    printf 'previous_operational_bundle_absent=%s\n' "$previous_operational_bundle_absent" >> "$temporary_phase"
    printf 'operational_bundle_activated=%s\n' "$operational_bundle_activated" >> "$temporary_phase"
    printf 'operational_bundle_directory=%s\n' "$operational_bundle_directory" >> "$temporary_phase"
    printf 'current_operational_bundle_checksum=%s\n' "$current_operational_bundle_checksum" >> "$temporary_phase"
    printf 'current_operational_bundle_revision=%s\n' "$current_operational_bundle_revision" >> "$temporary_phase"
    install -m 0600 "$temporary_phase" "$phase_file"
}

cleanup()
{
    for temporary_file in $temporary_files; do
        rm -f -- "$temporary_file"
    done
}

new_temporary_file()
{
    temporary_file="$(mktemp "${state_directory}/temporary.XXXXXX")"
    temporary_files="${temporary_files} ${temporary_file}"
}

environment_value()
{
    requested_key="$1"
    requested_file="$2"

    while IFS='=' read -r key value; do
        if [ "$key" = "$requested_key" ]; then
            printf '%s\n' "$value"
            return 0
        fi
    done < "$requested_file"

    return 1
}

json_value()
{
    requested_key="$1"
    requested_file="$2"

    sed -n "s/.*\"${requested_key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$requested_file" |
        head -n 1
}

load_monitoring_environment()
{
    if [ -z "$deployment_alert_command" ] && [ -r "$monitor_environment_file" ]; then
        set -a
        # The host-managed monitoring file supplies the existing Telegram delivery path.
        . "$monitor_environment_file"
        set +a
        deployment_alert_command="${MONITOR_DELIVERY_COMMAND:-}"
    fi

    if [ -z "$deployment_alert_command" ]; then
        deployment_alert_command='/usr/local/sbin/deliver-openclaw-monitor-alert'
    fi
}

send_deployment_alert()
{
    alert_message="$1"

    if [ ! -x "$deployment_alert_command" ]; then
        printf 'Deployment alert command is unavailable: %s\n' "$deployment_alert_command" >&2
        return 1
    fi

    "$deployment_alert_command" "$alert_message"
}

validate_digest()
{
    printf '%s\n' "$1" | grep -Eq '^sha256:[a-f0-9]{64}$' ||
        fail "$2 must be a sha256 digest"
}

validate_image_reference()
{
    printf '%s\n' "$1" | grep -Eq '^.+@sha256:[a-f0-9]{64}$' ||
        fail "$2 must include a repository and sha256 digest"
}

validate_database_identifier()
{
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$' ||
        fail "$2 must be a PostgreSQL identifier"
}

application_image_from()
{
    repository="$(environment_value APP_IMAGE_REPOSITORY "$1")" ||
        fail 'APP_IMAGE_REPOSITORY is required'
    digest="$(environment_value APP_IMAGE_DIGEST "$1")" ||
        fail 'APP_IMAGE_DIGEST is required'
    validate_digest "$digest" APP_IMAGE_DIGEST
    printf '%s@%s\n' "$repository" "$digest"
}

database_image_from()
{
    database_image="$(environment_value POSTGRES_IMAGE "$1")" ||
        fail 'POSTGRES_IMAGE is required'
    validate_image_reference "$database_image" POSTGRES_IMAGE
    printf '%s\n' "$database_image"
}

database_name_from()
{
    database_name="$(environment_value DB_DATABASE "$1" 2>/dev/null || printf '%s' money_assistant)"
    validate_database_identifier "$database_name" DB_DATABASE
    printf '%s\n' "$database_name"
}

database_user_from()
{
    database_user="$(environment_value DB_USERNAME "$1" 2>/dev/null || printf '%s' money_assistant)"
    validate_database_identifier "$database_user" DB_USERNAME
    printf '%s\n' "$database_user"
}

openclaw_version_from()
{
    openclaw_version="$(environment_value OPENCLAW_VERSION "$1")" ||
        fail 'OPENCLAW_VERSION is required'
    printf '%s\n' "$openclaw_version" | grep -Eq '^[0-9]{4}\.[0-9]+\.[0-9]+$' ||
        fail 'OPENCLAW_VERSION must be a pinned calendar version'
    printf '%s\n' "$openclaw_version"
}

compose()
{
    compose_environment="$1"
    shift

    docker compose \
        --project-name "$project_name" \
        --env-file "$compose_environment" \
        --file "$compose_file" \
        "$@"
}

write_candidate_environment()
{
    source_file="$1"
    target_file="$2"
    repository="$3"
    digest="$4"
    found_repository=false
    found_digest=false
    found_pull_policy=false
    found_deployment_requests=false

    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            APP_IMAGE_REPOSITORY=*)
                printf 'APP_IMAGE_REPOSITORY=%s\n' "$repository" >> "$target_file"
                found_repository=true
                ;;
            APP_IMAGE_DIGEST=*)
                printf 'APP_IMAGE_DIGEST=%s\n' "$digest" >> "$target_file"
                found_digest=true
                ;;
            APP_IMAGE_PULL_POLICY=*)
                printf '%s\n' 'APP_IMAGE_PULL_POLICY=never' >> "$target_file"
                found_pull_policy=true
                ;;
            DEPLOYMENT_REQUESTS_ENABLED=*)
                printf '%s\n' 'DEPLOYMENT_REQUESTS_ENABLED=false' >> "$target_file"
                found_deployment_requests=true
                ;;
            *) printf '%s\n' "$line" >> "$target_file" ;;
        esac
    done < "$source_file"

    if [ "$found_repository" = false ]; then
        printf 'APP_IMAGE_REPOSITORY=%s\n' "$repository" >> "$target_file"
    fi

    if [ "$found_digest" = false ]; then
        printf 'APP_IMAGE_DIGEST=%s\n' "$digest" >> "$target_file"
    fi

    if [ "$found_pull_policy" = false ]; then
        printf '%s\n' 'APP_IMAGE_PULL_POLICY=never' >> "$target_file"
    fi

    if [ "$found_deployment_requests" = false ]; then
        printf '%s\n' 'DEPLOYMENT_REQUESTS_ENABLED=false' >> "$target_file"
    fi
}

write_active_candidate_environment()
{
    source_file="$1"
    target_file="$2"
    found_deployment_requests=false

    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            DEPLOYMENT_REQUESTS_ENABLED=*)
                printf '%s\n' 'DEPLOYMENT_REQUESTS_ENABLED=true' >> "$target_file"
                found_deployment_requests=true
                ;;
            *) printf '%s\n' "$line" >> "$target_file" ;;
        esac
    done < "$source_file"

    if [ "$found_deployment_requests" = false ]; then
        printf '%s\n' 'DEPLOYMENT_REQUESTS_ENABLED=true' >> "$target_file"
    fi
}

service_is_healthy()
{
    checked_environment="$1"
    checked_service="$2"
    container_id="$(compose "$checked_environment" ps --quiet "$checked_service")"

    [ -n "$container_id" ] || return 1
    [ "$(docker inspect --format '{{.State.Status}}' "$container_id")" = running ] || return 1
    [ "$(docker inspect --format '{{.State.Health.Status}}' "$container_id")" = healthy ]
}

verify_release()
{
    verified_environment="$1"
    shift

    for service in "$@"; do
        if ! service_is_healthy "$verified_environment" "$service"; then
            printf 'Required service is unhealthy: %s\n' "$service" >&2
            return 1
        fi
    done

    curl \
        --fail \
        --noproxy '*' \
        --silent \
        --show-error \
        http://127.0.0.1:8443/up \
        >/dev/null
}

verify_web_release()
{
    verify_release "$1" postgres web proxy
}

verify_stack()
{
    verify_release "$1" postgres web worker scheduler proxy
}

json_escape()
{
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

record_release()
{
    outcome="$1"
    active_environment="$2"
    attempted_application_image="$3"
    previous_application_image="$4"
    maintenance_seconds="${5:-0}"
    active_application_image="$(application_image_from "$active_environment")"
    active_database_image="$(database_image_from "$active_environment")"
    active_openclaw_version="$(openclaw_version_from "$active_environment")"
    application_image_id="$(docker image inspect --format '{{.Id}}' "$active_application_image")"
    application_revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$active_application_image")"
    database_container_id="$(compose "$active_environment" ps --quiet postgres)"
    database_image_id="$(docker inspect --format '{{.Image}}' "$database_container_id")"
    database_version="$(docker exec "$database_container_id" postgres --version)"
    recorded_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    record_file="${state_directory}/$(date -u '+%Y%m%dT%H%M%SZ')-$$.json"
    new_temporary_file
    temporary_record="$temporary_file"

    {
        printf '{\n'
        printf '  "recorded_at": "%s",\n' "$(json_escape "$recorded_at")"
        printf '  "outcome": "%s",\n' "$(json_escape "$outcome")"
        printf '  "application_image": "%s",\n' "$(json_escape "$active_application_image")"
        printf '  "application_image_id": "%s",\n' "$(json_escape "$application_image_id")"
        printf '  "application_revision": "%s",\n' "$(json_escape "$application_revision")"
        printf '  "database_image": "%s",\n' "$(json_escape "$active_database_image")"
        printf '  "database_image_id": "%s",\n' "$(json_escape "$database_image_id")"
        printf '  "database_version": "%s",\n' "$(json_escape "$database_version")"
        printf '  "openclaw_version": "%s",\n' "$(json_escape "$active_openclaw_version")"
        printf '  "operational_bundle_checksum": "%s",\n' "$(json_escape "$operational_bundle_checksum")"
        printf '  "operational_bundle_revision": "%s",\n' "$(json_escape "$operational_bundle_revision")"
        printf '  "maintenance_seconds": %s,\n' "$maintenance_seconds"
        printf '  "attempted_application_image": "%s",\n' "$(json_escape "$attempted_application_image")"
        printf '  "previous_application_image": "%s"\n' "$(json_escape "$previous_application_image")"
        printf '}\n'
    } > "$temporary_record"

    install -m 0600 "$temporary_record" "$record_file"
    install -m 0600 "$temporary_record" "${state_directory}/current.json"
    DEPLOYMENT_STATE_DIRECTORY="$state_directory" \
        "${script_directory}/production-trust-gate" verify >/dev/null 2>&1 || true
}

activate_operational_bundle()
{
    [ -n "$operational_bundle_active_link" ] || return 0
    temporary_link="${operational_bundle_active_link}.candidate.$$"
    ln -s "$operational_bundle_directory" "$temporary_link"
    mv -Tf -- "$temporary_link" "$operational_bundle_active_link"
    operational_bundle_activated=true
}

capture_previous_operational_bundle()
{
    [ -n "$operational_bundle_active_link" ] || return 0
    if [ -L "$operational_bundle_active_link" ]; then
        previous_operational_bundle="$(readlink "$operational_bundle_active_link")"
    else
        previous_operational_bundle_absent=true
    fi
}

restore_operational_bundle()
{
    [ -n "$operational_bundle_active_link" ] || return 0
    [ "$operational_bundle_activated" = true ] || return 0
    if [ "$previous_operational_bundle_absent" = true ]; then
        rm -f -- "$operational_bundle_active_link"
        operational_bundle_activated=false
        return 0
    fi
    [ -n "$previous_operational_bundle" ] || return 1
    temporary_link="${operational_bundle_active_link}.restore.$$"
    ln -s "$previous_operational_bundle" "$temporary_link"
    mv -Tf -- "$temporary_link" "$operational_bundle_active_link"
    operational_bundle_activated=false
}

install_environment()
{
    source_file="$1"
    target_file="$2"
    target_directory="$(dirname -- "$target_file")"
    staged_environment="$(mktemp "${target_directory}/.production.env.XXXXXX")"
    temporary_files="${temporary_files} ${staged_environment}"

    install -m 0600 "$source_file" "$staged_environment"
    mv -f -- "$staged_environment" "$target_file"
}

verify_candidate_storage()
{
    storage_probe="${deployment_activation_marker}.preflight.$$"

    compose "$candidate_environment" run --rm --no-deps \
        migrate \
        /bin/sh \
        -c 'touch "$1" && rm -f "$1"' \
        deployment-storage-probe \
        "$storage_probe"
}

preflight_release()
{
    candidate_database_image="$(database_image_from "$candidate_environment")"

    [ -x "$deployment_alert_command" ] ||
        fail "the deployment alert command is not executable: $deployment_alert_command"
    compose "$candidate_environment" config --quiet ||
        fail 'the candidate Compose configuration is invalid'
    compose "$active_candidate_environment" config --quiet ||
        fail 'the active candidate Compose configuration is invalid'
    docker pull "$candidate_application_image" ||
        fail 'the candidate application image could not be pulled'
    docker pull "$candidate_database_image" ||
        fail 'the PostgreSQL image could not be pulled'
    compose "$candidate_environment" pull proxy ||
        fail 'the proxy image could not be pulled'
    docker image inspect "$candidate_application_image" >/dev/null ||
        fail 'the candidate application image is unreadable'
    verify_candidate_storage ||
        fail 'the shared application storage is not writable'

    previous_postgres_id="$(compose "$previous_environment" ps --quiet postgres)"
    previous_web_id="$(compose "$previous_environment" ps --quiet web)"
    if [ -n "$previous_web_id" ]; then
        had_previous_release=true
        verify_web_release "$previous_environment" ||
            fail 'the active web release is unhealthy before maintenance'
    elif [ -n "$previous_postgres_id" ]; then
        fail 'an incomplete production stack already exists'
    else
        compose "$candidate_environment" up --detach --wait --no-deps postgres ||
            fail 'PostgreSQL could not be initialized'
    fi

    compose "$candidate_environment" exec --no-TTY postgres pg_dump --version >/dev/null ||
        fail 'pg_dump is unavailable'
    compose "$candidate_environment" exec --no-TTY postgres pg_restore --version >/dev/null ||
        fail 'pg_restore is unavailable'

    database_size_bytes="$(compose "$candidate_environment" exec --no-TTY postgres \
        psql \
        --username "$(database_user_from "$candidate_environment")" \
        --dbname "$(database_name_from "$candidate_environment")" \
        --tuples-only \
        --no-align \
        --command 'SELECT pg_database_size(current_database())')" ||
        fail 'the database size could not be measured'
    case "$database_size_bytes" in
        ''|*[!0-9]*) fail 'the database size is invalid' ;;
    esac

    available_kilobytes="$(df -Pk "$state_directory" | awk 'NR == 2 { print $4 }')"
    minimum_free_kilobytes="${DEPLOYMENT_MIN_FREE_KILOBYTES:-1048576}"
    case "$available_kilobytes:$minimum_free_kilobytes" in
        *[!0-9:]*) fail 'deployment disk availability is invalid' ;;
    esac
    snapshot_kilobytes=$((database_size_bytes / 1024 + 1))
    required_kilobytes=$((minimum_free_kilobytes + snapshot_kilobytes * 2))
    [ "$available_kilobytes" -ge "$required_kilobytes" ] ||
        fail 'insufficient disk space for a verified rollback snapshot'
}

freeze_production_writers()
{
    maintenance_started_epoch="$(date +%s)"
    maintenance_active=true

    compose "$previous_environment" stop worker scheduler web proxy ||
        fail 'production writers could not be stopped'

    if [ -n "$(compose "$previous_environment" ps --quiet worker scheduler web proxy)" ]; then
        fail 'a production writer remained active at the snapshot boundary'
    fi

}

create_rollback_snapshot()
{
    rollback_snapshot="${state_directory}/rollback-$(date -u '+%Y%m%dT%H%M%SZ')-$$.dump"
    install -m 0600 /dev/null "$rollback_snapshot"

    compose "$previous_environment" exec --no-TTY postgres \
        pg_dump \
        --username "$(database_user_from "$previous_environment")" \
        --dbname "$(database_name_from "$previous_environment")" \
        --format=custom \
        --create \
        > "$rollback_snapshot" ||
        fail 'the rollback snapshot could not be created'

    [ "$(stat -c '%a' "$rollback_snapshot")" = 600 ] ||
        fail 'the rollback snapshot permissions are not restrictive'
    compose "$previous_environment" exec --no-TTY postgres \
        pg_restore --list < "$rollback_snapshot" >/dev/null ||
        fail 'the rollback snapshot is unreadable'
    snapshot_verified=true
}

remove_candidate_activation_marker()
{
    compose "$candidate_environment" run --rm --no-deps \
        migrate \
        /bin/rm \
        -f "$deployment_activation_marker"
}

create_candidate_activation_marker()
{
    compose "$candidate_environment" exec --user 33:33 --no-TTY web \
        touch "$deployment_activation_marker"
}

restore_database_snapshot()
{
    restored_database_name="$(database_name_from "$previous_environment")"
    restored_database_user="$(database_user_from "$previous_environment")"

    compose "$previous_environment" exec --no-TTY postgres \
        dropdb \
        --force \
        --if-exists \
        --username "$restored_database_user" \
        "$restored_database_name" || return 1
    compose "$previous_environment" exec --no-TTY postgres \
        pg_restore \
        --exit-on-error \
        --create \
        --username "$restored_database_user" \
        --dbname postgres \
        < "$rollback_snapshot" || return 1
}

activate_web_release()
{
    activated_environment="$1"

    compose "$activated_environment" up --detach --wait --no-deps web proxy || return 1
    verify_web_release "$activated_environment"
}

activate_background_services()
{
    activated_environment="$1"

    compose "$activated_environment" up --detach --wait --no-deps worker scheduler || return 1
    verify_stack "$activated_environment"
}

restore_transaction()
{
    [ "$rollback_attempted" = false ] || return 1
    rollback_attempted=true

    send_deployment_alert \
        "Production deployment failed for ${candidate_application_image}; automatic recovery started." || true
    printf '%s\n' 'Candidate deployment failed; restoring the PostgreSQL snapshot and previous image.' >&2

    compose "$candidate_environment" stop worker scheduler web proxy >/dev/null 2>&1 || true
    if [ -n "$previous_operational_bundle" ] &&
        [ -f "${previous_operational_bundle}/compose.production.yaml" ]; then
        compose_file="${previous_operational_bundle}/compose.production.yaml"
    fi
    if [ "$database_may_have_changed" = true ]; then
        [ "$snapshot_verified" = true ] || return 1
        [ -r "$rollback_snapshot" ] || return 1
        restore_database_snapshot || return 1
    fi
    [ "$had_previous_release" = true ] || return 1
    install_environment "$previous_environment" "$environment_file" || return 1
    restore_operational_bundle || return 1
    operational_bundle_checksum="$current_operational_bundle_checksum"
    operational_bundle_revision="$current_operational_bundle_revision"
    activate_web_release "$previous_environment" || return 1
    activate_background_services "$previous_environment" || return 1

    maintenance_seconds=$(($(date +%s) - maintenance_started_epoch))
    record_release \
        rolled_back \
        "$previous_environment" \
        "$candidate_application_image" \
        "$current_application_image" \
        "$maintenance_seconds" || return 1
    rm -f -- "$rollback_snapshot"
    rollback_snapshot=''
    snapshot_verified=false
    maintenance_active=false
    send_deployment_alert \
        "Production deployment recovered on ${current_application_image}; PostgreSQL and writers were restored." || true

    return 0
}

recover_interrupted_transaction()
{
    transaction_state="${state_directory}/transaction.state"
    [ -r "$transaction_state" ] || return 0
    interrupted_phase="$(environment_value phase "$transaction_state" 2>/dev/null || true)"
    case "$interrupted_phase" in
        maintenance|migrated|candidate_verified|bundle_activation_pending|bundle_activated|committed) ;;
        *) return 0 ;;
    esac

    requested_operational_bundle_checksum="$operational_bundle_checksum"
    requested_operational_bundle_revision="$operational_bundle_revision"
    requested_operational_bundle_directory="$operational_bundle_directory"
    requested_application_image_for_recovery="$requested_application_image"

    previous_environment="$(environment_value previous_environment "$transaction_state")"
    candidate_environment="$(environment_value candidate_environment "$transaction_state")"
    active_candidate_environment="$(environment_value active_candidate_environment "$transaction_state")"
    rollback_snapshot="$(environment_value rollback_snapshot "$transaction_state")"
    current_application_image="$(environment_value current_application_image "$transaction_state")"
    candidate_application_image="$(environment_value application_image "$transaction_state")"
    had_previous_release="$(environment_value had_previous_release "$transaction_state")"
    database_may_have_changed="$(environment_value database_may_have_changed "$transaction_state")"
    snapshot_verified="$(environment_value snapshot_verified "$transaction_state")"
    maintenance_started_epoch="$(environment_value maintenance_started_epoch "$transaction_state")"
    previous_operational_bundle="$(environment_value previous_operational_bundle "$transaction_state")"
    [ "$previous_operational_bundle" = __absent__ ] && previous_operational_bundle=''
    previous_operational_bundle_absent="$(environment_value previous_operational_bundle_absent "$transaction_state")"
    operational_bundle_activated="$(environment_value operational_bundle_activated "$transaction_state")"
    operational_bundle_directory="$(environment_value operational_bundle_directory "$transaction_state")"
    operational_bundle_checksum="$(environment_value operational_bundle_checksum "$transaction_state")"
    operational_bundle_revision="$(environment_value source_revision "$transaction_state")"
    current_operational_bundle_checksum="$(environment_value current_operational_bundle_checksum "$transaction_state")"
    current_operational_bundle_revision="$(environment_value current_operational_bundle_revision "$transaction_state")"
    temporary_files="${temporary_files} ${previous_environment} ${candidate_environment} ${active_candidate_environment}"

    if [ "$interrupted_phase" = committed ]; then
        compose_file="${operational_bundle_directory}/compose.production.yaml"
        create_candidate_activation_marker || fail 'the committed candidate request gate could not be opened'
        activate_background_services "$active_candidate_environment" ||
            fail 'the committed candidate background services could not be recovered'
        maintenance_seconds=$(($(date +%s) - maintenance_started_epoch))
        record_release \
            deployed \
            "$environment_file" \
            "$candidate_application_image" \
            "$current_application_image" \
            "$maintenance_seconds"
        rm -f -- "$rollback_snapshot"
        rollback_snapshot=''
        record_deployment_phase deployed
        if [ "$requested_application_image_for_recovery" = "$candidate_application_image" ] &&
            [ "$requested_operational_bundle_checksum" = "$operational_bundle_checksum" ]; then
            interrupted_candidate_completed=true
        fi
        operational_bundle_checksum="$requested_operational_bundle_checksum"
        operational_bundle_revision="$requested_operational_bundle_revision"
        operational_bundle_directory="$requested_operational_bundle_directory"
        compose_file="${requested_operational_bundle_directory}/compose.production.yaml"
        printf '%s\n' 'Interrupted committed deployment converged on the verified candidate.'
        return 0
    fi

    if [ "$interrupted_phase" = bundle_activation_pending ] &&
        [ -L "$operational_bundle_active_link" ] &&
        [ "$(readlink "$operational_bundle_active_link")" = "$operational_bundle_directory" ]; then
        operational_bundle_activated=true
    fi
    maintenance_active=true
    restore_transaction || fail "interrupted deployment at ${interrupted_phase} could not be restored"
    operational_bundle_checksum="$requested_operational_bundle_checksum"
    operational_bundle_revision="$requested_operational_bundle_revision"
    operational_bundle_directory="$requested_operational_bundle_directory"
    compose_file="${requested_operational_bundle_directory}/compose.production.yaml"
    printf 'Interrupted deployment at %s converged on the verified previous release.\n' "$interrupted_phase"
}

finish()
{
    status=$?
    trap - EXIT HUP INT TERM

    if [ "$status" -ne 0 ] && [ "$maintenance_active" = true ]; then
        if ! restore_transaction; then
            printf '%s\n' 'Automatic recovery failed; the rollback snapshot was retained and writers remain stopped.' >&2
            send_deployment_alert \
                "Production deployment recovery failed for ${candidate_application_image}; writers remain stopped." || true
        fi
    elif [ "$status" -ne 0 ] && [ "$deployment_started" = true ]; then
        send_deployment_alert \
            "Production deployment failed for ${candidate_application_image:-unknown}; the database commit point was preserved without automatic rollback." || true
    fi

    cleanup
    exit "$status"
}

deploy_release()
{
    new_temporary_file
    previous_environment="$temporary_file"
    new_temporary_file
    candidate_environment="$temporary_file"
    new_temporary_file
    active_candidate_environment="$temporary_file"
    cp -- "$environment_file" "$previous_environment"
    current_application_image="$(application_image_from "$previous_environment")"
    if [ -r "${state_directory}/current.json" ]; then
        current_operational_bundle_checksum="$(json_value operational_bundle_checksum "${state_directory}/current.json")"
        current_operational_bundle_revision="$(json_value operational_bundle_revision "${state_directory}/current.json")"
    fi

    if [ -n "$requested_application_image" ]; then
        validate_image_reference "$requested_application_image" APPLICATION_IMAGE
        candidate_repository="${requested_application_image%@*}"
        candidate_digest="${requested_application_image##*@}"
    else
        candidate_repository="${current_application_image%@*}"
        candidate_digest="${current_application_image##*@}"
    fi

    write_candidate_environment \
        "$previous_environment" \
        "$candidate_environment" \
        "$candidate_repository" \
        "$candidate_digest"
    candidate_application_image="$(application_image_from "$candidate_environment")"
    write_active_candidate_environment "$candidate_environment" "$active_candidate_environment"

    capture_previous_operational_bundle
    record_deployment_phase staged
    preflight_release
    freeze_production_writers
    record_deployment_phase maintenance
    remove_candidate_activation_marker ||
        fail 'the candidate request gate could not be closed'
    create_rollback_snapshot

    database_may_have_changed=true
    compose "$candidate_environment" run --rm --no-deps migrate ||
        fail 'the candidate migration failed'
    record_deployment_phase migrated
    activate_web_release "$candidate_environment" ||
        fail 'the candidate web release failed health verification'
    record_deployment_phase candidate_verified

    maintenance_seconds=$(($(date +%s) - maintenance_started_epoch))
    install -m 0600 "$previous_environment" "${state_directory}/previous.env"
    install_environment "$active_candidate_environment" "$environment_file"
    record_deployment_phase bundle_activation_pending
    activate_operational_bundle
    record_deployment_phase bundle_activated
    record_release \
        activating \
        "$environment_file" \
        "$candidate_application_image" \
        "$current_application_image" \
        "$maintenance_seconds"
    record_deployment_phase committed
    rm -f -- "$rollback_snapshot"
    rollback_snapshot=''
    snapshot_verified=false
    maintenance_active=false
    create_candidate_activation_marker ||
        fail 'the candidate request gate could not be opened'
    activate_background_services "$active_candidate_environment" ||
        fail 'the candidate background services failed health verification'

    record_release \
        deployed \
        "$environment_file" \
        "$candidate_application_image" \
        "$current_application_image" \
        "$maintenance_seconds"
    record_deployment_phase deployed
    printf 'Production deployment is healthy after %s seconds of maintenance: %s\n' \
        "$maintenance_seconds" "$candidate_application_image"
}

rollback_release()
{
    previous_release_environment="${state_directory}/previous.env"

    if [ ! -r "$previous_release_environment" ]; then
        fail 'no previous release is available'
    fi

    new_temporary_file
    current_environment="$temporary_file"
    new_temporary_file
    rollback_environment="$temporary_file"
    cp -- "$environment_file" "$current_environment"
    cp -- "$previous_release_environment" "$rollback_environment"
    current_image="$(application_image_from "$current_environment")"
    rollback_image="$(application_image_from "$rollback_environment")"

    if ! compose "$rollback_environment" up --detach --wait --pull never ||
        ! verify_stack "$rollback_environment"; then
        if ! compose "$current_environment" up --detach --wait --pull never ||
            ! verify_stack "$current_environment"; then
            fail 'neither the previous nor current release became healthy'
        fi

        fail 'the previous release did not become healthy; the current release was restored'
    fi

    install -m 0600 "$current_environment" "${state_directory}/previous.env"
    install_environment "$rollback_environment" "$environment_file"
    record_release \
        rolled_back \
        "$environment_file" \
        "$rollback_image" \
        "$current_image"
    printf 'Production rollback is healthy: %s\n' "$rollback_image"
}

trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$#" -lt 1 ]; then
    usage >&2
    exit 2
fi

action="$1"
shift

while [ "$#" -gt 0 ]; do
    case "$1" in
        --app-image)
            [ "$#" -ge 2 ] || fail '--app-image requires a value'
            requested_application_image="$2"
            shift 2
            ;;
        --env-file)
            [ "$#" -ge 2 ] || fail '--env-file requires a value'
            environment_file="$2"
            shift 2
            ;;
        *)
            usage >&2
            fail "unknown argument: $1"
            ;;
    esac
done

case "$action" in
    deploy | rollback | verify) ;;
    *)
        usage >&2
        fail "unknown action: $action"
        ;;
esac

if [ ! -r "$environment_file" ]; then
    fail "environment file is not readable: $environment_file"
fi

command -v docker >/dev/null 2>&1 || fail 'docker is required'
command -v flock >/dev/null 2>&1 || fail 'flock is required'
command -v curl >/dev/null 2>&1 || fail 'curl is required'
command -v sed >/dev/null 2>&1 || fail 'sed is required'
command -v awk >/dev/null 2>&1 || fail 'awk is required'

install -d -m 0700 "$state_directory"
exec 9>"${state_directory}/deployment.lock"
flock -n 9 || fail 'another deployment operation is in progress'
load_monitoring_environment

case "$action" in
    deploy)
        deployment_started=true
        recover_interrupted_transaction
        if [ "$interrupted_candidate_completed" = false ]; then
            deploy_release
        fi
        ;;
    rollback) rollback_release ;;
    verify)
        application_image_from "$environment_file" >/dev/null
        database_image_from "$environment_file" >/dev/null
        openclaw_version_from "$environment_file" >/dev/null
        verify_stack "$environment_file" || fail 'the production stack is unhealthy'
        record_release \
            verified \
            "$environment_file" \
            "$(application_image_from "$environment_file")" \
            ''
        printf '%s\n' 'Production stack verification passed.'
        ;;
esac
