#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
compose_file="${COMPOSE_FILE:-${script_directory}/compose.production.yaml}"
configuration_directory="${MONEY_ASSISTANT_CONFIGURATION_DIRECTORY:-/etc/money-assistant}"
environment_file="${ENVIRONMENT_FILE:-${configuration_directory}/production.env}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
lock_file="${DEPLOYMENT_LOCK_FILE:-/tmp/money-assistant-production-deployment.lock}"

fail()
{
    printf 'Production deployment failed: %s\n' "$1" >&2
    exit 1
}

compose()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$environment_file" \
        --file "$compose_file" \
        "$@"
}

command -v docker >/dev/null 2>&1 || fail 'Docker is required'
command -v flock >/dev/null 2>&1 || fail 'flock is required'
[ -r "$compose_file" ] || fail "Compose file is not readable: $compose_file"
[ -r "$environment_file" ] || fail "environment file is not readable: $environment_file"

exec 9> "$lock_file"
flock --nonblock 9 || fail 'another deployment is already running'

compose config --quiet
compose build --pull migrate
compose up --detach --wait postgres
compose run --rm --no-deps migrate
compose up --detach --wait --remove-orphans --force-recreate --no-deps web worker scheduler proxy

printf '%s\n' 'Production deployment completed successfully.'
