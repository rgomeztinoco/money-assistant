MONITOR_STATE_DIRECTORY=/var/lib/money-assistant/monitor/independent
MONITOR_DELIVERY_COMMAND=/usr/local/sbin/deliver-independent-monitor-alert
MONITOR_DIRECT_DELIVERY_COMMAND=/usr/local/sbin/deliver-telegram-monitor-alert
MONITOR_PRIMARY_DELIVERY_TIMEOUT_SECONDS=5
MONITOR_TELEGRAM_BOT_TOKEN_FILE=/etc/money-assistant/monitor-telegram-bot-token
MONITOR_TELEGRAM_CHAT_ID=123456789
APPLICATION_MONITOR_HOST=money-assistant-monitor@100.64.0.10
APPLICATION_MONITOR_KNOWN_HOSTS_FILE=/etc/money-assistant/application-monitor-known-hosts
APPLICATION_MONITOR_SSH_KEY_FILE=/etc/money-assistant/application-monitor-key
MONITOR_BACKUP_STATUS_FILE=/var/lib/money-assistant/monitor/backup-status
MONITOR_RESTORE_STATUS_FILE=/var/lib/money-assistant/monitor/restore-status
