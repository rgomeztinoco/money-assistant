#!/bin/sh

set -eu

umask 077

configuration_file="${DEPLOYMENT_CONFIGURATION_FILE:-/etc/money-assistant/deployment.env}"
expected_uid="${DEPLOYMENT_EXPECTED_UID:-0}"
launcher="${DEPLOYMENT_LAUNCHER:-/usr/local/sbin/activate-production-release}"
systemctl_command="${DEPLOYMENT_SYSTEMCTL:-/usr/bin/systemctl}"
host_verifier="${DEPLOYMENT_HOST_VERIFIER:-/usr/local/sbin/verify-production-deployment}"
curl_command="${DEPLOYMENT_CURL:-curl}"
revision="${1:-}"
download_directory=''

fail()
{
    printf 'Manual production deployment failed: %s\n' "$1" >&2
    exit 1
}

cleanup()
{
    if [ -n "$download_directory" ]; then
        rm -rf -- "$download_directory"
    fi
}

configuration_value()
{
    requested_key="$1"
    requested_file="$2"
    value_count="$(awk -F= -v key="$requested_key" '$1 == key { count++ } END { print count + 0 }' "$requested_file")"
    [ "$value_count" -eq 1 ] || fail "configuration must contain exactly one ${requested_key}"
    awk -F= -v key="$requested_key" '$1 == key { print substr($0, length(key) + 2) }' "$requested_file"
}

metadata_value()
{
    requested_key="$1"
    value_count="$(awk -F= -v key="$requested_key" '$1 == key { count++ } END { print count + 0 }' "$metadata_file")"
    [ "$value_count" -eq 1 ] || fail "release metadata must contain exactly one ${requested_key}"
    awk -F= -v key="$requested_key" '$1 == key { print substr($0, length(key) + 2) }' "$metadata_file"
}

download()
{
    asset_name="$1"
    "$curl_command" \
        --proto '=https' \
        --tlsv1.2 \
        --fail \
        --location \
        --silent \
        --show-error \
        --output "${download_directory}/${asset_name}" \
        "${release_base_url}/${asset_name}" || fail "could not download ${asset_name}"
}

trap cleanup EXIT HUP INT TERM

[ "$(id -u)" = "$expected_uid" ] || fail 'run this command as root'
[ "$#" -eq 1 ] || fail 'usage: deploy-production-release REVISION'
printf '%s\n' "$revision" | grep -Eq '^[a-f0-9]{40}$' || fail 'revision must be a 40-character Git commit'
[ -f "$configuration_file" ] && [ ! -L "$configuration_file" ] || fail 'deployment configuration is unavailable'
[ "$(stat -c '%u' "$configuration_file")" = "$expected_uid" ] || fail 'deployment configuration has an untrusted owner'
[ "$(stat -c '%a' "$configuration_file")" = 600 ] || fail 'deployment configuration permissions are not restrictive'

github_repository="$(configuration_value DEPLOYMENT_GITHUB_REPOSITORY "$configuration_file")"
expected_image_repository="$(configuration_value DEPLOYMENT_IMAGE_REPOSITORY "$configuration_file")"
production_environment="$(configuration_value PRODUCTION_ENV_FILE "$configuration_file")"
printf '%s\n' "$github_repository" | grep -Eq '^[a-z0-9_.-]+/[a-z0-9_.-]+$' || fail 'configured GitHub repository is invalid'
printf '%s\n' "$expected_image_repository" | grep -Eq '^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_.-]+$' || fail 'configured image repository is invalid'
[ -f "$production_environment" ] && [ ! -L "$production_environment" ] || fail 'host-managed production environment is unavailable'
[ -x "$launcher" ] && [ ! -L "$launcher" ] || fail 'stable host launcher is unavailable'
[ -x "$host_verifier" ] && [ ! -L "$host_verifier" ] || fail 'host deployment verifier is unavailable'

release_base_url="${DEPLOYMENT_RELEASE_BASE_URL:-https://github.com/${github_repository}/releases/download/release-${revision}}"
download_directory="$(mktemp -d)"
bundle_name="operational-bundle-${revision}.tar"
checksum_name="${bundle_name}.sha256"
metadata_name="release-metadata-${revision}.env"
bundle_file="${download_directory}/${bundle_name}"
checksum_file="${download_directory}/${checksum_name}"
metadata_file="${download_directory}/${metadata_name}"

download "$bundle_name"
download "$checksum_name"
download "$metadata_name"

awk -F= '
    $1 == "SOURCE_REVISION" || $1 == "APPLICATION_IMAGE" || $1 == "BUNDLE_CHECKSUM" { entries++; next }
    { invalid = 1 }
    END { exit invalid || entries != 3 }
' "$metadata_file" || fail 'release metadata has an unexpected shape'

metadata_revision="$(metadata_value SOURCE_REVISION)"
application_image="$(metadata_value APPLICATION_IMAGE)"
bundle_checksum="$(metadata_value BUNDLE_CHECKSUM)"
[ "$metadata_revision" = "$revision" ] || fail 'release metadata revision does not match'
printf '%s\n' "$application_image" | grep -Eq '^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_.-]+@sha256:[a-f0-9]{64}$' ||
    fail 'release image is invalid'
[ "${application_image%@*}" = "$expected_image_repository" ] || fail 'release image repository is not allowed'
printf '%s\n' "$bundle_checksum" | grep -Eq '^[a-f0-9]{64}$' || fail 'release bundle checksum is invalid'
[ "$(awk 'NR == 1 { print $1 }' "$checksum_file")" = "$bundle_checksum" ] || fail 'published checksums do not match'
[ "$(sha256sum "$bundle_file" | awk '{ print $1 }')" = "$bundle_checksum" ] || fail 'downloaded bundle checksum does not match'

"$launcher" deploy \
    --source-revision "$revision" \
    --app-image "$application_image" \
    --bundle-checksum "$bundle_checksum" \
    --bundle "$bundle_file" \
    --env-file "$production_environment"

"$systemctl_command" enable --now \
    money-assistant-production.service \
    money-assistant-tailnet.service || fail 'production services could not be enabled'
"$host_verifier" || fail 'production host verification failed'

printf 'Production release activated manually: %s\n' "$revision"
