#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
rotation_command="${script_directory}/rehearse-credential-rotation"

[ "$#" -eq 6 ] || {
    printf '%s\n' 'Usage: rehearse-all-credential-rotations PRIVATE_KEY_FILE PUBLIC_KEY_FILE KEY_ID HOOK_TOKEN_FILE APP_KEY_FILE PREVIOUS_KEYS_FILE' >&2
    exit 2
}

inbound_proof="$("$rotation_command" inbound "$1" "$2" "$3")"
printf '%s\n' "$inbound_proof"
printf '%s\n' "$inbound_proof" |
    grep -Fxq 'CREDENTIAL_ROTATION_DIRECTION direction=inbound outcome=passed'

outbound_proof="$("$rotation_command" outbound "$4")"
printf '%s\n' "$outbound_proof"
printf '%s\n' "$outbound_proof" |
    grep -Fxq 'CREDENTIAL_ROTATION_DIRECTION direction=outbound outcome=passed'

application_proof="$("$rotation_command" application "$5" "$6")"
printf '%s\n' "$application_proof"
printf '%s\n' "$application_proof" |
    grep -Fxq 'CREDENTIAL_ROTATION_DIRECTION direction=application outcome=passed'

printf '%s\n' 'All inbound, outbound, and application credential rotations passed.'
printf '%s\n' 'PRODUCTION_TRUST_EVIDENCE gate=credential-rotation outcome=passed'
