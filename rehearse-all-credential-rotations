#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
rotation_command="${script_directory}/rehearse-credential-rotation"

[ "$#" -eq 2 ] || {
    printf '%s\n' 'Usage: rehearse-all-credential-rotations APP_KEY_FILE PREVIOUS_KEYS_FILE' >&2
    exit 2
}

application_proof="$("$rotation_command" application "$1" "$2")"
printf '%s\n' "$application_proof"
printf '%s\n' "$application_proof" |
    grep -Fxq 'CREDENTIAL_ROTATION_DIRECTION direction=application outcome=passed'

printf '%s\n' 'Application credential rotation passed.'
printf '%s\n' 'PRODUCTION_TRUST_EVIDENCE gate=credential-rotation outcome=passed'
