#!/bin/sh

set -eu

expected_uid="${DEPLOYMENT_EXPECTED_UID:-0}"
expected_owner="${DEPLOYMENT_EXPECTED_OWNER:-root:root}"
configuration_directory="${DEPLOYMENT_CONFIGURATION_DIRECTORY:-/etc/money-assistant}"
active_bundle="${DEPLOYMENT_ACTIVE_BUNDLE:-/var/lib/money-assistant/operational-bundles/active}"
production_environment="${configuration_directory}/production.env"
deployment_configuration="${configuration_directory}/deployment.env"
launcher="${DEPLOYMENT_LAUNCHER:-/usr/local/sbin/activate-production-release}"
manual_deployer="${DEPLOYMENT_MANUAL_DEPLOYER:-/usr/local/sbin/deploy-production-release}"

fail()
{
    printf 'Production deployment verification failed: %s\n' "$1" >&2
    exit 1
}

verify_root_file()
{
    verified_file="$1"
    expected_mode="$2"
    [ -f "$verified_file" ] && [ ! -L "$verified_file" ] || fail "required host file is invalid: $verified_file"
    [ "$(stat -c '%U:%G' "$verified_file")" = "$expected_owner" ] || fail "host file is not root-owned: $verified_file"
    [ "$(stat -c '%a' "$verified_file")" = "$expected_mode" ] || fail "host file mode is invalid: $verified_file"
}

[ "$(id -u)" = "$expected_uid" ] || fail 'run this verifier as root'
verify_root_file "$deployment_configuration" 600
verify_root_file "$production_environment" 600
verify_root_file "$launcher" 755
verify_root_file "$manual_deployer" 755

[ -L "$active_bundle" ] && [ -d "$active_bundle" ] || fail 'no active immutable operational bundle is installed'
systemctl is-enabled --quiet money-assistant-production.service || fail 'production service is not enabled'
systemctl is-enabled --quiet money-assistant-tailnet.service || fail 'tailnet service is not enabled'
systemctl is-active --quiet money-assistant-production.service || fail 'production service is not active'
systemctl is-active --quiet money-assistant-tailnet.service || fail 'tailnet service is not active'

PRODUCTION_ENV_FILE="$production_environment" \
    OPERATIONAL_BUNDLE_ACTIVE_LINK="$active_bundle" \
    "${active_bundle}/verify-active-production-release"
"${active_bundle}/verify-private-ingress" "$production_environment"

printf '%s\n' 'Manual production deployment is healthy and reboot-persistent.'
