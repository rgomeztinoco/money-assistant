#!/usr/bin/env bash

set -Eeuo pipefail

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
compose_file="${COMPOSE_FILE:-${script_directory}/compose.production.yaml}"
environment_file="${ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"
identity_file="${BACKUP_AGE_IDENTITY_FILE:?Set BACKUP_AGE_IDENTITY_FILE}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
backup_path="${1:-}"
restore_database="${2:-}"
database_created=false

fail()
{
    printf 'Production database restore failed: %s\n' "$1" >&2
    exit 1
}

postgres()
{
    docker compose \
        --project-name "$project_name" \
        --env-file "$environment_file" \
        --file "$compose_file" \
        exec --no-TTY postgres \
        "$@"
}

cleanup()
{
    exit_status="$?"

    if [ "$exit_status" -ne 0 ] && [ "$database_created" = true ]; then
        postgres dropdb --if-exists --force --username "${DB_USERNAME:-money_assistant}" "$restore_database" >/dev/null 2>&1 || true
    fi

    exit "$exit_status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

command -v age >/dev/null 2>&1 || fail 'age is required'
command -v docker >/dev/null 2>&1 || fail 'Docker is required'
[ -r "$environment_file" ] || fail "environment file is not readable: $environment_file"
[ -r "$identity_file" ] || fail "Age identity file is not readable: $identity_file"
[ -r "$backup_path" ] || fail 'provide a readable encrypted backup path'

set -a
. "$environment_file"
set +a

production_database="${DB_DATABASE:-money_assistant}"
printf '%s\n' "$restore_database" | grep -Eq '^money_assistant_restore_[a-zA-Z0-9_]+$' ||
    fail 'restore database must match money_assistant_restore_[a-zA-Z0-9_]+'
[ "$restore_database" != "$production_database" ] || fail 'restore database must not be the production database'

if postgres psql \
    --username "${DB_USERNAME:-money_assistant}" \
    --dbname postgres \
    --tuples-only \
    --no-align \
    --command "SELECT 1 FROM pg_database WHERE datname = '${restore_database}'" |
    grep -q 1; then
    fail "restore database already exists: $restore_database"
fi

postgres createdb --username "${DB_USERNAME:-money_assistant}" "$restore_database"
database_created=true

age --decrypt --identity "$identity_file" "$backup_path" |
    postgres pg_restore \
        --username "${DB_USERNAME:-money_assistant}" \
        --dbname "$restore_database" \
        --exit-on-error \
        --no-owner \
        --no-privileges

postgres psql \
    --username "${DB_USERNAME:-money_assistant}" \
    --dbname "$restore_database" \
    --tuples-only \
    --no-align \
    --command 'SELECT count(*) FROM migrations' |
    grep -Eq '^[1-9][0-9]*$' || fail 'restored database does not contain applied migrations'

printf 'Encrypted database restore verified: %s\n' "$restore_database"
