#!/usr/bin/env bash

set -Eeuo pipefail

umask 077

: "${APPLICATION_BACKUP_HOST:?Set APPLICATION_BACKUP_HOST}"
: "${APPLICATION_BACKUP_KNOWN_HOSTS_FILE:?Set APPLICATION_BACKUP_KNOWN_HOSTS_FILE}"
: "${APPLICATION_BACKUP_SSH_KEY_FILE:?Set APPLICATION_BACKUP_SSH_KEY_FILE}"
: "${RESTIC_PASSWORD_FILE:?Set RESTIC_PASSWORD_FILE}"
: "${RESTIC_REPOSITORY:?Set RESTIC_REPOSITORY}"

backup_lock_file="${BACKUP_LOCK_FILE:-/run/lock/money-assistant-backup-pull.lock}"
restic_host="${RESTIC_HOST:-money-assistant-application-host}"
backup_status_file="${BACKUP_STATUS_FILE:-/var/lib/money-assistant/monitor/backup-status}"
backup_completed=false

record_backup_status()
{
    install -d -m 0700 "$(dirname -- "$backup_status_file")"
    temporary_status="${backup_status_file}.tmp.$$"
    printf '%s %s\n' "$1" "$(date +%s)" > "$temporary_status"
    mv -f -- "$temporary_status" "$backup_status_file"
}

finish()
{
    exit_status="$?"
    if [ "$backup_completed" = true ]; then
        record_backup_status success
    else
        record_backup_status failed
    fi
    exit "$exit_status"
}

trap finish EXIT

command -v flock >/dev/null 2>&1
command -v restic >/dev/null 2>&1
command -v ssh >/dev/null 2>&1

exec 9>"$backup_lock_file"
flock --nonblock 9 || {
    printf '%s\n' 'A Money Assistant backup pull is already running.' >&2
    exit 1
}

ssh \
    -o BatchMode=yes \
    -o ClearAllForwardings=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -o "UserKnownHostsFile=${APPLICATION_BACKUP_KNOWN_HOSTS_FILE}" \
    -i "$APPLICATION_BACKUP_SSH_KEY_FILE" \
    -T "$APPLICATION_BACKUP_HOST" export \
    | restic backup \
        --stdin \
        --stdin-filename money-assistant-backup.tar.age \
        --host "$restic_host" \
        --tag money-assistant

restic forget \
    --tag money-assistant \
    --keep-daily 7 \
    --keep-weekly 5 \
    --keep-monthly 12 \
    --prune

restic check

backup_completed=true
printf '%s\n' 'Encrypted Money Assistant backup pull and retention completed.'
printf '%s\n' 'PRODUCTION_TRUST_EVIDENCE gate=backup-retention outcome=passed'
