#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
allowlist="${script_directory}/operational-bundle.allowlist"

fail()
{
    printf 'Operational bundle build failed: %s\n' "$1" >&2
    exit 1
}

[ "$#" -eq 2 ] || fail 'usage: build-operational-bundle SOURCE_REVISION OUTPUT'
source_revision="$1"
output="$2"
printf '%s\n' "$source_revision" | grep -Eq '^[a-f0-9]{40}$' ||
    fail 'source revision must be a 40-character Git commit'
[ -f "$allowlist" ] && [ ! -L "$allowlist" ] || fail 'the operational allowlist is invalid'

staging_directory="$(mktemp -d)"
trap 'rm -rf -- "$staging_directory"' EXIT HUP INT TERM
manifest="${staging_directory}/MANIFEST.sha256"
: > "$manifest"
printf '%s\n' "$source_revision" > "${staging_directory}/SOURCE_REVISION"
chmod 0644 "${staging_directory}/SOURCE_REVISION"

while IFS=' ' read -r path mode extra; do
    [ -n "$path" ] || continue
    [ -z "${extra:-}" ] || fail "invalid allowlist entry: $path"
    case "$path" in /*|*..*|*\\*) fail "unsafe allowlist path: $path" ;; esac
    source_file="${script_directory}/${path}"
    [ -f "$source_file" ] && [ ! -L "$source_file" ] || fail "allowlisted asset is invalid: $path"
    case "$mode" in 0644|0755) ;; *) fail "unsupported permission for $path" ;; esac
    install -D -m "$mode" "$source_file" "${staging_directory}/${path}"
    printf '%s %s %s\n' "$mode" "$(sha256sum "${staging_directory}/${path}" | awk '{ print $1 }')" "$path" >> "$manifest"
done < "$allowlist"

printf '%s %s %s\n' 0644 "$(sha256sum "${staging_directory}/SOURCE_REVISION" | awk '{ print $1 }')" SOURCE_REVISION >> "$manifest"
chmod 0644 "$manifest"
output_directory="$(dirname -- "$output")"
[ -d "$output_directory" ] || install -d -m 0700 "$output_directory"
temporary_bundle="$(mktemp "${output_directory}/.operational-bundle.XXXXXX")"
tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
    -cf "$temporary_bundle" -C "$staging_directory" .
chmod 0644 "$temporary_bundle"
mv -f -- "$temporary_bundle" "$output"
sha256sum "$output" | awk '{ print $1 }'
