#!/bin/sh

set -eu

umask 077

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
backup_user="${BACKUP_EXPORT_USER:-money-assistant-backup}"
backup_home="${BACKUP_EXPORT_HOME:-/home/${backup_user}}"

fail()
{
    printf 'Production backup export installation failed: %s\n' "$1" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'run this installer as root'
[ "$#" -eq 2 ] || fail 'usage: install-production-backup-export SSH_PUBLIC_KEY_FILE AGE_RECIPIENT_FILE'

ssh_public_key_file="$1"
age_recipient_file="$2"
[ -r "$ssh_public_key_file" ] || fail "SSH public key is not readable: $ssh_public_key_file"
[ -r "$age_recipient_file" ] || fail "age recipient is not readable: $age_recipient_file"

ssh_public_key="$(cat "$ssh_public_key_file")"
printf '%s\n' "$ssh_public_key" | awk '
    NR == 1 && NF >= 2 && $1 == "ssh-ed25519" && $2 ~ /^[A-Za-z0-9+\/=]+$/ { valid = 1 }
    END { exit ! (valid && NR == 1) }
' ||
    fail 'the pull device must use an ssh-ed25519 public key'
awk 'NR == 1 && $0 ~ /^age1[0-9a-z]+$/ { valid = 1 } END { exit ! (valid && NR == 1) }' \
    "$age_recipient_file" || fail 'the age recipient is invalid'

if ! id "$backup_user" >/dev/null 2>&1; then
    useradd --create-home --home-dir "$backup_home" --shell /bin/sh --user-group "$backup_user"
else
    usermod --home "$backup_home" --shell /bin/sh "$backup_user"
fi
usermod --lock "$backup_user"

install -d -m 0700 -o "$backup_user" -g "$backup_user" "${backup_home}/.ssh"
printf 'restrict,command="sudo -n /usr/local/sbin/export-production-backup" %s\n' "$ssh_public_key" \
    > "${backup_home}/.ssh/authorized_keys"
chown "$backup_user:$backup_user" "${backup_home}/.ssh/authorized_keys"
chmod 0600 "${backup_home}/.ssh/authorized_keys"

install -d -m 0700 /etc/money-assistant
install -m 0644 "$age_recipient_file" /etc/money-assistant/backup-recipient.txt
install -m 0755 "${script_directory}/export-production-backup" /usr/local/sbin/export-production-backup
printf '%s ALL=(root) NOPASSWD: /usr/local/sbin/export-production-backup\n' "$backup_user" \
    > /etc/sudoers.d/money-assistant-backup
chmod 0440 /etc/sudoers.d/money-assistant-backup
visudo --check --file=/etc/sudoers.d/money-assistant-backup >/dev/null

printf '%s\n' 'Installed a forced, read-only backup export for the second device.'
