#!/bin/sh

set -eu

script_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
systemd_directory="${SYSTEMD_DIRECTORY:-/etc/systemd/system}"
environment_file="${ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"

fail()
{
    printf 'Production service installation failed: %s\n' "$1" >&2
    exit 1
}

if [ "$(id -u)" -ne 0 ]; then
    fail 'run this installer as root'
fi

if [ ! -x "${script_directory}/deploy-production" ]; then
    fail 'the production deployment is not installed'
fi

if [ ! -r "$environment_file" ]; then
    fail "production environment is not readable: $environment_file"
fi

install -m 0644 \
    "${script_directory}/money-assistant-production.service" \
    "${systemd_directory}/money-assistant-production.service"
install -m 0644 \
    "${script_directory}/money-assistant-tailnet.service" \
    "${systemd_directory}/money-assistant-tailnet.service"

install -d -m 0700 /var/backups/money-assistant
install -m 0755 "${script_directory}/export-production-backup" /usr/local/sbin/export-production-backup
install -m 0755 "${script_directory}/restore-production-backup" /usr/local/sbin/restore-production-backup
install -m 0644 "${script_directory}/money-assistant-backup.service" "${systemd_directory}/money-assistant-backup.service"
install -m 0644 "${script_directory}/money-assistant-backup.timer" "${systemd_directory}/money-assistant-backup.timer"

systemctl daemon-reload
systemctl enable --now money-assistant-production.service money-assistant-tailnet.service
systemctl enable --now money-assistant-backup.timer

printf '%s\n' 'Production services and encrypted daily database backups are enabled.'
