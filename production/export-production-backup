#!/usr/bin/env bash

set -Eeuo pipefail

umask 077

application_directory="${MONEY_ASSISTANT_APPLICATION_DIRECTORY:-/opt/money-assistant}"
compose_file="${COMPOSE_FILE:-${application_directory}/compose.production.yaml}"
environment_file="${ENVIRONMENT_FILE:-/etc/money-assistant/production.env}"
recipient_file="${BACKUP_AGE_RECIPIENT_FILE:-/etc/money-assistant/backup-recipient.txt}"
backup_directory="${BACKUP_DIRECTORY:-/var/backups/money-assistant}"
project_name="${COMPOSE_PROJECT_NAME:-money-assistant-production}"
lock_file="${BACKUP_LOCK_FILE:-${backup_directory}/backup.lock}"
temporary_backup=''

fail()
{
    printf 'Production database backup failed: %s\n' "$1" >&2
    exit 1
}

cleanup()
{
    if [ -n "$temporary_backup" ]; then
        rm -f -- "$temporary_backup"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

command -v age >/dev/null 2>&1 || fail 'age is required'
command -v docker >/dev/null 2>&1 || fail 'Docker is required'
command -v flock >/dev/null 2>&1 || fail 'flock is required'
[ -r "$environment_file" ] || fail "environment file is not readable: $environment_file"
[ -s "$recipient_file" ] || fail "Age recipient file is not readable or is empty: $recipient_file"

set -a
. "$environment_file"
set +a

install -d -m 0700 "$backup_directory"
exec 9> "$lock_file"
flock --nonblock 9 || fail 'another backup is already running'

backup_name="money-assistant-$(date -u '+%Y%m%dT%H%M%SZ').dump.age"
backup_path="${backup_directory}/${backup_name}"
temporary_backup="${backup_path}.tmp.$$"

docker compose \
    --project-name "$project_name" \
    --env-file "$environment_file" \
    --file "$compose_file" \
    exec --no-TTY postgres \
    pg_dump \
        --username "${DB_USERNAME:-money_assistant}" \
        --dbname "${DB_DATABASE:-money_assistant}" \
        --format=custom \
        --no-owner \
        --no-privileges \
    | age --encrypt --recipients-file "$recipient_file" --output "$temporary_backup"

chmod 0600 "$temporary_backup"
mv -- "$temporary_backup" "$backup_path"
temporary_backup=''

find "$backup_directory" \
    -type f \
    -name 'money-assistant-*.dump.age' \
    -mtime +30 \
    -delete

printf 'Encrypted database backup created: %s\n' "$backup_path"
